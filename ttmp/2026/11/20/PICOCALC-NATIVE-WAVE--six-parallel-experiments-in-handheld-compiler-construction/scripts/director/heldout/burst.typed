record Calibration {
    offset: i32;
    scale: i32;
    dropped: i32;
}

function codeValue(ch: i32): i32 {
    return ch - 48;
}

function digit(ch: i32): bool {
    return 48 <= ch && ch <= 57;
}

function corrected(c: Calibration, raw: i32): i32 {
    return raw * c.scale + c.offset;
}

function dropped(c: Calibration): i32 {
    return c.dropped;
}

function checksum(sum: i32, n: i32): i32 {
    return (sum * 13 + n) % 4093;
}

function countEvents(text: string, start: i32, stop: i32): i32 {
    if (start < 0 || stop > text.length) return -1;
    let count = 0;
    let cursor = start;
    while (cursor < stop) {
        const ch = text.charCodeAt(cursor);
        if (ch === 59) { count = count + 1; }
        cursor = cursor + 1;
    }
    return count;
}

function inspect(text: string, at: i32, stop: i32): i32 {
    if (0 <= at && at < stop && stop <= text.length) return text.charCodeAt(at);
    return -1;
}

function uncheckedRequest(text: string, at: i32): i32 {
    return text.charCodeAt(at);
}

function readBurst(text: string, c: Calibration, start: i32, stop: i32): i32 {
    if (start < 0 || stop > text.length || stop < start) return -1;
    let i = start;
    let sum = 0;
    let value = 0;
    let used = 0;
    while (i < stop) {
        const ch = text.charCodeAt(i);
        if (digit(ch)) {
            value = (value * 10 + codeValue(ch)) % 4093;
            used = used + 1;
        } else if (ch === 59) {
            if (used > 0) { sum = checksum(sum, corrected(c, value)); }
            value = 0;
            used = 0;
        } else {
            return -2;
        }
        i = i + 1;
    }
    if (used > 0) { sum = checksum(sum, corrected(c, value)); }
    return sum;
}

function label(out: buffer, at: i32, count: i32): i32 {
    if (count === 0) return out.writeLiteral(at, "No events in this window");
    if (count === 1) return out.writeLiteral(at, "One event in this window");
    return out.writeLiteral(at, "Two or more events in this window");
}
