record Header { length: i32; }

function shrink(header: Header): i32 {
    header.length = 1;
    return 0;
}

function unrelated(n: i32): i32 {
    let x = n;
    for (let i = 0; i < 4; i = i + 1) {
        x = (x * 5 + 8) % 867 + n;
        x = (x * 7 + 3) % 123 + n;
        x = (x * 11 + 7) % 653 + n;
        x = (x * 13 + 4) % 551 + n;
        x = (x * 17 + 2) % 801 + n;
        x = (x * 19 + 6) % 157 + n;
        x = (x * 23 + 3) % 450 + n;
        x = (x * 29 + 9) % 765 + n;
        x = (x * 31 + 5) % 337 + n;
        x = (x * 37 + 1) % 971 + n;
        x = (x * 41 + 3) % 680 + n;
        x = (x * 43 + 5) % 340 + n;
        x = (x * 47 + 6) % 816 + n;
        x = (x * 53 + 7) % 643 + n;
        x = (x * 59 + 8) % 164 + n;
        x = (x * 61 + 9) % 235 + n;
        x = (x * 67 + 6) % 543 + n;
        x = (x * 71 + 7) % 153 + n;
        x = (x * 73 + 9) % 569 + n;
        x = (x * 79 + 3) % 378 + n;
        x = (x * 83 + 6) % 593 + n;
        x = (x * 89 + 8) % 893 + n;
        x = (x * 97 + 2) % 249 + n;
        x = (x * 101 + 4) % 209 + n;
        x = (x * 103 + 5) % 773 + n;
        x = (x * 107 + 6) % 501 + n;
        x = (x * 109 + 7) % 257 + n;
        x = (x * 113 + 3) % 243 + n;
        x = (x * 127 + 9) % 219 + n;
    }
    return x;
}

function repeated(text: string, position: i32): i32 {
    let first = text.charCodeAt(position);
    let second = text.charCodeAt(position);
    return first + second + text.charCodeAt(position);
}
function reassigned(text: string, p: i32, q: i32): i32 {
    let position = p;
    let first = text.charCodeAt(position);
    position = q;
    return first + text.charCodeAt(position);
}
function branch(text: string, p: i32, take: bool): i32 {
    let first = 0;
    if (take) { first = text.charCodeAt(p); }
    return first + text.charCodeAt(p);
}
function called(text: string, header: Header, p: i32): i32 {
    let first = text.charCodeAt(p);
    shrink(header);
    return first + text.charCodeAt(p);
}
function stored(text: string, header: Header, p: i32): i32 {
    let first = text.charCodeAt(p);
    header.length = 1;
    return first + text.charCodeAt(p);
}
function rhsOrder(dst: buffer, src: string, p: i32, q: i32): i32 {
    dst.setCharCodeAt(0, 513);
    dst.setCharCodeAt(p, src.charCodeAt(q));
    return 7;
}
function literals(dst: buffer, p: i32, useLong: bool): i32 {
    if (useLong) return dst.writeLiteral(p, "ab☺€🐈cd");
    return dst.writeLiteral(p, "ab☺€🐈c");
}
