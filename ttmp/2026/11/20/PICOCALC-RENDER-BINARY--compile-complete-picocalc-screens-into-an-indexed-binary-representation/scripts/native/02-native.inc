    int previous=-1;
    for(unsigned i=0;i<n;i++) {
        const uint8_t *slot=b->p+a+2+i*step;
        if(t==7) {
            int key=(int)bx16(slot);
            if(key<=previous||key>=b->strings||++b->stringUses>4096)return false;
            previous=key;slot+=2;
