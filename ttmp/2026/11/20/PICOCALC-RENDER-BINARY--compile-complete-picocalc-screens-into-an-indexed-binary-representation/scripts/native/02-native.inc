static bool bx_jtext(const char *s,int *uses){
    if(!s||++*uses>4096)return false;
    bx_str v=bx_cstr(s);return v.n<=2048&&bx_utf(v,NULL);
}
static bool bx_jverify(const cJSON *j,int depth,int *values,int *uses){
    if(!j||depth>24||++*values>8192)return false;
    if(cJSON_IsString(j))return bx_jtext(j->valuestring,uses);
    if(cJSON_IsNumber(j))return isfinite(j->valuedouble);
    if(cJSON_IsBool(j)||cJSON_IsNull(j))return true;
    bool map=cJSON_IsObject(j);
    if(!map&&!cJSON_IsArray(j))return false;
    int n=0;
    for(const cJSON *p=j->child;p;p=p->next){
        if(++n>(map?64:1024))return false;
        if(map){if(!bx_jtext(p->string,uses))return false;
            for(const cJSON *q=j->child;q!=p;q=q->next)if(!strcmp(p->string,q->string))return false;}
        if(!bx_jverify(p,depth+1,values,uses))return false;
    }
    return true;
}
// cJSON represents text with a terminating NUL. Exclude escaped U+0000 before materialization.
// Bound nesting before the general-purpose recursive parser, then validate the materialized tree.
static bool bx_json_preflight(const uint8_t *p,size_t n){
    if(n>32768)return false;
    bool quoted=false;int depth=0;
    for(size_t i=0;i<n;i++){
        uint8_t c=p[i];if(!c)return false;
        if(quoted && c=='\\'){
            if(++i>=n)return false;
            if(p[i]=='u'&&n-i>=5&&!memcmp(p+i,"u0000",5))return false;
        } else if(c=='"')quoted=!quoted;
        else if(!quoted){
            if(c=='['||c=='{'){if(++depth>25)return false;}
            if(c==']'||c=='}'){if(--depth<0)return false;}
        }
    }
    return !quoted&&depth==0;
