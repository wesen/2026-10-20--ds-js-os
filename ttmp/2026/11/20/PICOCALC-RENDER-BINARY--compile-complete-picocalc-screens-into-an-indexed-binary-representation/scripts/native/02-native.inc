            const bx_step *p=i&1?s->late:s->first;
            hb+=bin?bx_weight(&b,bx_path(&b,p)):bx_jweight(bx_jpath(j,p));
        }
        uint64_t v=BX_NOW();
        hc=bin?bx_weight(&b,bx24(b.p+10)):bx_jweight(j);
        uint64_t w=BX_NOW();
