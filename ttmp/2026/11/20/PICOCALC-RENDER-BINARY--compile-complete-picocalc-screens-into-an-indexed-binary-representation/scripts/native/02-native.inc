static const bx_spec *bx_select(const char *arm,int *binary){
    size_t n=strlen(arm);
    if(n<3||arm[n-2]!='-'||(arm[n-1]!='B'&&arm[n-1]!='G'))return NULL;
    *binary=arm[n-1]=='B';
    for(size_t i=0;i<sizeof(bx_fixtures)/sizeof(bx_fixtures[0]);i++)
        if(n-2==strlen(bx_fixtures[i].app)&&!memcmp(arm,bx_fixtures[i].app,n-2))return &bx_fixtures[i];
    return NULL;
}
static int bx_run(const char *arm,int reps) {
