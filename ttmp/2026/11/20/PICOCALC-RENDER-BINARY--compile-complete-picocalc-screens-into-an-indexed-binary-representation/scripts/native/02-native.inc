        }else{
            if(!bx_json_preflight(s->json,s->nj))return 5;
            const char *end=NULL;
            j=cJSON_ParseWithLengthOpts((const char*)s->json,s->nj+1,&end,1);
            int count=0,uses=0;
            if(!j||end!=(const char*)s->json+s->nj||!bx_jverify(j,0,&count,&uses)||!bx_json_shape(j,s->app)){
                cJSON_Delete(j);return 6;
