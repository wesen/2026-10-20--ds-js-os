static bool bx_json_shape(cJSON *j,const char *sender){
    cJSON *app=cJSON_GetObjectItemCaseSensitive(j,"app"),*f=cJSON_GetObjectItemCaseSensitive(j,"frame");
    return cJSON_IsString(app)&&!strcmp(app->valuestring,sender)&&
           cJSON_IsString(cJSON_GetObjectItemCaseSensitive(j,"title"))&&
           cJSON_IsString(cJSON_GetObjectItemCaseSensitive(f,"hints"))&&
           cJSON_IsObject(cJSON_GetObjectItemCaseSensitive(f,"tree"));
