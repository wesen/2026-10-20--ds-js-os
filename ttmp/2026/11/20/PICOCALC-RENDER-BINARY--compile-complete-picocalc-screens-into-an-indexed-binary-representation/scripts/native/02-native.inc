        if(ha!=s->hlate||hb!=16u*(s->hfirst+s->hlate)||hc!=s->hfull)return 7;
    }
    printf("LAB NATIVEBIN %s {\"reps\":%d,\"bytes\":%u,\"admitUs\":%" PRIu64 ",\"lookupUs\":%" PRIu64
           ",\"repeatLookupUs\":%" PRIu64 ",\"walkUs\":%" PRIu64 ",\"releaseUs\":%" PRIu64
           ",\"lookupHash\":%u,\"repeatLookupHash\":%u,\"walkHash\":%u}\n",
           arm,reps,(unsigned)(bin?s->nb:s->nj),ad,once,repeated,walk,release,(unsigned)ha,(unsigned)hb,(unsigned)hc);
    return 0;
}
static void bx_trial(const char *arm,int reps) {
    int code=bx_run(arm,reps);if(code)printf("LAB ERROR nativebin %s %d\n",arm,code);
}
