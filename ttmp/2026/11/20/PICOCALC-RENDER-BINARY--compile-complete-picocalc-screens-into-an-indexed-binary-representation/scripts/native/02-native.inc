static const cJSON *bx_jpath(const cJSON *j,const bx_step *path){
    for(;path->key||path->index>=0;path++)j=path->key?cJSON_GetObjectItemCaseSensitive(j,path->key):cJSON_GetArrayItem(j,path->index);
    return j;
}
static uint32_t bx_jweight(const cJSON *j){
    if(!j)return 199;
    if(cJSON_IsString(j))return bx_hash(bx_cstr(j->valuestring))+41;
    if(cJSON_IsNumber(j))return bx_number(j->valuedouble);
    if(cJSON_IsNull(j))return 151;
    if(cJSON_IsTrue(j))return 17;
    if(cJSON_IsFalse(j))return 31;
    bool map=cJSON_IsObject(j);uint32_t h=map?907:3,index=0;
    for(const cJSON *c=j->child;c;c=c->next,index++){
        uint32_t k=map?bx_hash(bx_cstr(c->string))+65537:index+11;
        h+=k*bx_jweight(c);
