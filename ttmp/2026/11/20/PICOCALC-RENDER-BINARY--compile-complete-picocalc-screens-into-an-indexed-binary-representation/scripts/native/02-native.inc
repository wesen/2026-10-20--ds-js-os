            else if(c>=224&&c<=239){c&=15;more=2;min=2048;}
            else if(c>=240&&c<=244){c&=7;more=3;min=65536;}
            else return false;
            if(more>s.n-i)return false;
            while(more--){uint8_t x=s.p[i++];if((x&192)!=128)return false;c=(c<<6)|(x&63);}
            if(c<min || c>0x10ffff || (c>=0xd800&&c<=0xdfff))return false;
        }
        if(c==0)return false; // matched native cJSON subdomain excludes U+0000.
        if(weight){if(c>65535){c-=65536;h=(h*33)^(0xd800+(c>>10));c=0xdc00+(c&1023);}h=(h*33)^c;}
    }
