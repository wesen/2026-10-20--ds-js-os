    if(t<=2)return !a;
    if(t==3)return true;
    if(t==5)return a<(unsigned)b->strings && ++b->stringUses<=4096;
    if(a!=b->cursor)return false;
    if(t==4) {
        if(a+8>b->n)return false;
        double d=bx_float(b->p+a);b->cursor+=8;
        return isfinite(d) && !(d>=-524288 && d<=524287 && d==(double)(int32_t)d);
    }
    if((t!=6&&t!=7)||a+2>b->n)return false;
    unsigned n=bx16(b->p+a),step=t==6?3:5;
    if(n>(t==6?1024u:64u))return false;
    b->cursor+=2+n*step;
