static uint32_t bx_hash(bx_str s){uint32_t h=0;bx_utf(s,&h);return h;}
static double bx_float(const uint8_t *p) {
    uint64_t bits=0;for(unsigned i=0;i<8;i++)bits|=(uint64_t)p[i]<<(8*i);
    double d;memcpy(&d,&bits,8);return d;
