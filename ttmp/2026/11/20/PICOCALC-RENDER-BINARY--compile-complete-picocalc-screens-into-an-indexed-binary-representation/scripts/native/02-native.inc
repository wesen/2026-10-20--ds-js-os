static bool bx_open(bx_data *b,const uint8_t *p,size_t n){
    if(n<15||n>32768||memcmp(p,"PSIX\1\0",6)||bx16(p+6)!=n)return false;
    int count=(int)bx16(p+8);unsigned start=13+2*(count+1);
    if(count>4096||start>n||bx16(p+13)!=start)return false;
    *b=(bx_data){.p=p,.n=n,.strings=count};
    for(int i=0;i<count;i++){
        unsigned end=bx16(p+15+2*i);
        if(end<start||end>n||end-start>2048)return false;
        bx_str s=bx_string(b,i);
        if(!bx_utf(s,NULL)||(i&&bx_cmp(bx_string(b,i-1),s)>=0))return false;
        start=end;
    }
