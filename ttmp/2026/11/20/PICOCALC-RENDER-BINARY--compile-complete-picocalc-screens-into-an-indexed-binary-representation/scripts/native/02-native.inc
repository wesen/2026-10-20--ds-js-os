#define BX_MISSING 0xffffffffu
static uint32_t bx_field(const bx_data *b,uint32_t ref,const char *key) {
    if(ref>>20!=7)return BX_MISSING;
    const uint8_t *p=b->p+(ref&0xfffff);int lo=0,hi=(int)bx16(p);bx_str wanted=bx_cstr(key);
    while(lo<hi){int mid=(lo+hi)/2;const uint8_t *slot=p+2+5*mid;
        int c=bx_cmp(wanted,bx_string(b,bx16(slot)));
        if(!c)return bx24(slot+2);
        if(c<0)hi=mid;else lo=mid+1;
    }
    return BX_MISSING;
}
static uint32_t bx_path(const bx_data *b,const bx_step *path) {
    uint32_t ref=bx24(b->p+10);
    for(;path->key||path->index>=0;path++){
        if(path->key)ref=bx_field(b,ref,path->key);
        else {
            if(ref>>20!=6)return BX_MISSING;
            const uint8_t *p=b->p+(ref&0xfffff);
            if((unsigned)path->index>=bx16(p))return BX_MISSING;
            ref=bx24(p+2+3*path->index);
        }
    }
    return ref;
}
static bool bx_shape(const bx_data *b,const char *sender) {
    uint32_t r=bx24(b->p+10),a=bx_field(b,r,"app"),f=bx_field(b,r,"frame");
    return a>>20==5 && !bx_cmp(bx_string(b,a&0xfffff),bx_cstr(sender)) &&
           bx_field(b,r,"title")>>20==5 && bx_field(b,f,"hints")>>20==5 && bx_field(b,f,"tree")>>20==7;
}
static uint32_t bx_number(double d) {
    char s[80];
    if(d>=(double)INT32_MIN && d<=(double)INT32_MAX && (double)(int32_t)d==d)
        snprintf(s,sizeof(s),"%" PRId32,(int32_t)d);
    else snprintf(s,sizeof(s),"%.15g",d); // corpus subset: verified against primary's JS witness below
    return bx_hash(bx_cstr(s))+89;
}
static uint32_t bx_weight(const bx_data *b,uint32_t ref) {
    uint32_t t=ref>>20,a=ref&0xfffff;
    if(t==0)return 151;
    if(t==1)return 31;
    if(t==2)return 17;
    if(t==3)return bx_number(a>=0x80000?(int32_t)a-0x100000:(int32_t)a);
    if(t==4)return bx_number(bx_float(b->p+a));
    if(t==5)return bx_hash(bx_string(b,a))+41;
    if(t>7)return 199;
    const uint8_t *p=b->p+a;unsigned n=bx16(p);
    uint32_t h=t==6?n+3:907;
    for(unsigned i=0;i<n;i++) {
        const uint8_t *slot=p+2+i*(t==6?3:5);
        uint32_t k=t==6?i+11:bx_hash(bx_string(b,bx16(slot)))+65537;
        h+=k*bx_weight(b,bx24(slot+(t==6?0:2)));
