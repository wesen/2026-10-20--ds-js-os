# candela-typed: the playable firmware plus the gallery's Typed arm (PICOCALC-CANDELA-TYPED): apps/typed/candela-gallery,
# Candela's kernel and the 18 scenes' sections in Typed, compiled to RV32 on the handheld on the arm's first use
# (`gallery arm typed`, `gallery digest ID N psram typed`). The C++ kernel stays the default arm.
SDKCONFIG_NAME=candela-typed
SDKCONFIG_DEFAULTS=(sdkconfig.defaults sdkconfig.smooth-chess sdkconfig.reproducible)
APPS=(chess agenda editor files candela raytrace candela-gallery)
OPTIONS=(PICOCALC_DEVICE_COMPILER=ON PICOCALC_CANDELA_GALLERY=ON)
