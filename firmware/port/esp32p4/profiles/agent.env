# agent: the HTTPS agent transport over the onboard ESP32-C6 (docs/agent/picocalc-agent-implementation.md, part B).
# The Wi-Fi credentials and token are provisioned into NVS later; never put them in a profile.
SDKCONFIG_NAME=agent
SDKCONFIG_DEFAULTS=(sdkconfig.defaults sdkconfig.agent-wifi sdkconfig.reproducible)
OPTIONS=(PICOCALC_AGENT_WIFI=ON)
