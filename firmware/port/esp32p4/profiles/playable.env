# playable: the firmware the PicoCalc is left on (AGENTS.md; firmware/PLAYABLE.json records the installed build).
# Typed Chess, Agenda, Editor and Files compiled to RV32 on the handheld by the device compiler, the
# application-delivered 3D Chess painter, and the Candela gallery (18 path-traced scenes on screen).
SDKCONFIG_NAME=playable
SDKCONFIG_DEFAULTS=(sdkconfig.defaults sdkconfig.smooth-chess sdkconfig.reproducible)
OPTIONS=(PICOCALC_HEADLESS=OFF PICOCALC_DEVICE_COMPILER=ON
         PICOCALC_RV32_CHESS=ON PICOCALC_RV32_AGENDA=ON PICOCALC_RV32_EDITOR=ON PICOCALC_RV32_FILES=ON
         PICOCALC_RV32_STREAM_FUNCTIONS=ON PICOCALC_AGENT_WIFI=OFF
         PICOCALC_MOBILE_PAINTER=ON PICOCALC_CHESS_3D=ON PICOCALC_CANDELA_GALLERY=ON)
