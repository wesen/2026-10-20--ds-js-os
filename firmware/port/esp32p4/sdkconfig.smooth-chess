# Ordinary smooth 3D Chess firmware. Apply after sdkconfig.defaults.
CONFIG_ESP32P4_REV_MIN_1=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_360=y
CONFIG_CACHE_L2_CACHE_LINE_64B=y
CONFIG_ELF_LOADER_LOAD_PSRAM=y

# Match the ordinary release's flash-safe peripheral code and PSRAM policy.
CONFIG_PERIPH_CTRL_FUNC_IN_IRAM=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
CONFIG_MBEDTLS_CMAC_C=y
CONFIG_LWIP_TCP_OOSEQ_MAX_PBUFS=0
