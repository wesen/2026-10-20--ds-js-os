# cmake -DJS_ROOT=.../js -DOUT=js_bundle.c -P bundle_js.cmake
# Writes every .js and .json file under JS_ROOT into a C table, NUL-terminated, keyed by its path in JS_ROOT.
file(GLOB_RECURSE files RELATIVE ${JS_ROOT} ${JS_ROOT}/*.js ${JS_ROOT}/*.json)
list(SORT files)
set(out "// Generated by bundle_js.cmake from js/. Do not edit.\n#include <stddef.h>\n")
set(table "")
set(i 0)
foreach(f ${files})
  file(READ ${JS_ROOT}/${f} hex HEX)
  string(LENGTH "${hex}" hl)
  math(EXPR n "${hl} / 2")
  string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," hex "${hex}")
  string(APPEND out "static const unsigned char f${i}[] = {${hex}0};\n")
  string(APPEND table "  { \"${f}\", f${i}, ${n} },\n")
  math(EXPR i "${i} + 1")
endforeach()
string(APPEND out "const struct js_file { const char *path; const unsigned char *data; size_t len; } js_bundle[] = {\n${table}  { 0, 0, 0 },\n};\n")
file(WRITE ${OUT} "${out}")
