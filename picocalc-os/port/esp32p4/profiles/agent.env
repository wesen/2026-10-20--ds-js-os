# agent: the HTTPS agent transport over the onboard ESP32-C6 (docs/picocalc-agent-implementation.md, part B).
# The Wi-Fi credentials and token are provisioned into NVS later; never put them in a profile.
# SDKCONFIG_SEED: the tracked full configuration this build starts from (copied into the build directory once).
SDKCONFIG_NAME=agent
SDKCONFIG_SEED=sdkconfig.agent
SDKCONFIG_DEFAULTS=(sdkconfig.defaults sdkconfig.agent-wifi)
OPTIONS=(PICOCALC_AGENT_WIFI=ON)
