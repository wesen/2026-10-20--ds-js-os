# picocalc-os on the M5Stack PaperS3: ESP32-S3R8 (8 MB octal PSRAM), 16 MB flash, ESP-IDF v5.3.4.
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# PSRAM: world arenas and the framebuffers live there. M5GFX's EPD bus needs octal mode.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y

# The console is the native USB Serial/JTAG (the board has no UART bridge).
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# A 1 ms tick: the kernel's idle waits and the touch poll are in milliseconds.
CONFIG_FREERTOS_HZ=1000
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
# The kernel task runs on core 1 and may keep it busy through boot; it is not stuck when it does.
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU1=n
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_LOG_COLORS=n

# Power management (PAPERS3-IDLE P4): the clock scales down and the chip light-sleeps whenever every task waits.
# While a host is on the USB console the chip stays awake (the console does not survive light sleep).
CONFIG_PM_ENABLE=y
CONFIG_FREERTOS_USE_TICKLESS_IDLE=y
CONFIG_FREERTOS_IDLE_TIME_BEFORE_SLEEP=3
CONFIG_USJ_NO_AUTO_LS_ON_CONNECTION=y
CONFIG_PM_PROFILING=y
# Light sleep isolates every pin (CONFIG_PM_SLP_DISABLE_GPIO, forced on by the S3's GPIO reset workaround); the
# power latch and the panel's pins are exempted in bus_s3.cpp (gpio_sleep_sel_dis).

# Caches (PAPERS3-IDLE P5): code runs from flash, and worlds' arenas and the framebuffers live in PSRAM. A 32 KB
# instruction cache and 64-byte data lines took a System-app repaint from 94 to 58 ms; a 64 KB data cache added
# nothing and would cost 32 KB more internal RAM (diary step 10).
CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y
CONFIG_ESP32S3_INSTRUCTION_CACHE_LINE_32B=y
CONFIG_ESP32S3_DATA_CACHE_32KB=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y
