// Append a JSON string from a UTF-16 span. This also handles filenames and
// text containing control characters without leaking them into the UI tree.
function editorHex(digit: i32): i32 {
    if (digit < 10) return 48 + digit;
    return 87 + digit;
}

function editorQuoteContent(output: buffer, offset: i32, text: string, first: i32, end: i32): i32 {
    let at = offset;
    let i = first;
    while (i < end) {
        const unit = text.charCodeAt(i);
        if (unit < 32) {
            at = at + output.writeLiteral(at, "\\u00");
            output.setCharCodeAt(at, editorHex(unit / 16));
            output.setCharCodeAt(at + 1, editorHex(unit % 16));
            at = at + 2;
        }
        if (unit >= 32) {
            if (unit === 34 || unit === 92) { at = at + output.writeLiteral(at, "\\"); }
            output.setCharCodeAt(at, unit);
            at = at + 1;
        }
        i = i + 1;
    }
    return at;
}

function editorQuote(output: buffer, offset: i32, text: string, first: i32, end: i32): i32 {
    const at = editorQuoteContent(output, offset + output.writeLiteral(offset, "\""), text, first, end);
    return at + output.writeLiteral(at, "\"");
}

function editorLineEnd(text: string, first: i32): i32 {
    if (first >= text.length) return first;
    return typedSdkSeek(text, first, text.length, 10, 10, 10, 10);
}

function editorFirstRow(text: string, state: WorldState): i32 {
    state.row = 0;
    state.line = 0;
    state.rowStart = 0;
    state.lineStart = 0;
    state.fenced = false;
    state.lineEnd = editorLineEnd(text, 0);
    state.rowEnd = editorWrapEnd(text, 0, state.lineEnd, 49);
    return 0;
}

function editorNextRow(text: string, state: WorldState): bool {
    if (state.rowEnd === text.length) return false;
    if (state.markdown && state.rowStart === state.lineStart && editorMdFence(text, state.lineStart, state.lineEnd)) {
        state.fenced = !state.fenced;
    }
    state.rowStart = state.rowEnd;
    if (state.rowEnd === state.lineEnd) {
        state.lineStart = state.lineEnd + 1;
        state.lineEnd = editorLineEnd(text, state.lineStart);
        state.rowStart = state.lineStart;
        state.line = state.line + 1;
    }
    state.rowEnd = editorWrapEnd(text, state.rowStart, state.lineEnd, 49);
    state.row = state.row + 1;
    return true;
}

function editorStoreRow(rows: buffer, state: WorldState): i32 {
    const slot = (state.row % 18) * 7;
    rows.setCharCodeAt(slot, state.rowStart % 65536);
    rows.setCharCodeAt(slot + 1, state.rowStart / 65536);
    rows.setCharCodeAt(slot + 2, state.lineStart % 65536);
    rows.setCharCodeAt(slot + 3, state.lineStart / 65536);
    rows.setCharCodeAt(slot + 4, state.line % 65536);
    rows.setCharCodeAt(slot + 5, state.line / 65536);
    rows.setCharCodeAt(slot + 6, 0);
    if (state.fenced) { rows.setCharCodeAt(slot + 6, 1); }
    return 0;
}

function editorFrameRow(text: string, state: WorldState, row: i32): i32 {
    const rows = typedSdkBuffer(9);
    state.row = row;
    const slot = (state.row % 18) * 7;
    state.rowStart = rows.charCodeAt(slot) + rows.charCodeAt(slot + 1) * 65536;
    state.lineStart = rows.charCodeAt(slot + 2) + rows.charCodeAt(slot + 3) * 65536;
    state.line = rows.charCodeAt(slot + 4) + rows.charCodeAt(slot + 5) * 65536;
    state.fenced = rows.charCodeAt(slot + 6) === 1;
    state.lineEnd = editorLineEnd(text, state.lineStart);
    state.rowEnd = editorWrapEnd(text, state.rowStart, state.lineEnd, 49);
    return 0;
}

function editorNeedsRow(text: string, state: WorldState): bool {
    return state.rowEnd < text.length && (state.cursor > state.rowEnd ||
        (state.cursor === state.rowEnd && state.rowEnd < state.lineEnd));
}

function editorLocate(text: string, state: WorldState): i32 {
    editorFirstRow(text, state);
    while (editorNeedsRow(text, state)) { editorNextRow(text, state); }
    return editorColumn(text, state.rowStart, state.cursor);
}

function editorFrameLocate(text: string, state: WorldState): bool {
    const rows = typedSdkBuffer(9);
    if (state.frameRow === 0) { editorFirstRow(text, state); }
    if (state.frameRow > 0) { editorFrameRow(text, state, state.frameRow); }
    const stop = state.row + 64;
    while (state.row < stop && editorNeedsRow(text, state)) {
        editorStoreRow(rows, state);
        editorNextRow(text, state);
    }
    editorStoreRow(rows, state);
    state.frameRow = 0;
    if (!editorNeedsRow(text, state)) return true;
    state.frameToken = typedSdkYield();
    if (state.frameToken > 0) { state.frameRow = state.row; }
    return false;
}

function editorDigits(output: buffer, start: i32, value: i32): i32 {
    let divisor = 1;
    let at = start;
    while (value / divisor >= 10) { divisor = divisor * 10; }
    while (divisor > 0) {
        output.setCharCodeAt(at, 48 + ((value / divisor) % 10));
        divisor = divisor / 10;
        at = at + 1;
    }
    return at;
}

function editorSavedStatus(output: buffer, bytes: i32): i32 {
    const end = editorDigits(output, output.writeLiteral(0, "Saved "), bytes);
    return end + output.writeLiteral(end, " bytes.");
}

function editorSaveError(output: buffer, size: i32): i32 {
    if (size <= 0) return output.writeLiteral(0, "Not saved.");
    const reason = typedSdkBuffer(4);
    const start = output.writeLiteral(0, "Not saved: ");
    let count = Math.min(size, output.length - start);
    if (count < size && count > 0 && editorHighSurrogate(reason.charCodeAt(count - 1))) {
        count = count - 1;
    }
    let i = 0;
    while (i < count) {
        output.setCharCodeAt(start + i, reason.charCodeAt(i));
        i = i + 1;
    }
    return start + count;
}
