function editorEqual(left: buffer, len: i32, right: buffer, size: i32): bool {
    if (!(len === size)) return false;
    let i = 0;
    while (i < len && left.charCodeAt(i) === right.charCodeAt(i)) { i = i + 1; }
    return i === len;
}

function editorKeyCode(key: buffer, len: i32, b: buffer): i32 {
    if (editorEqual(key, len, b, b.writeLiteral(0, "left"))) return 1;
    if (editorEqual(key, len, b, b.writeLiteral(0, "right"))) return 2;
    if (editorEqual(key, len, b, b.writeLiteral(0, "up"))) return 3;
    if (editorEqual(key, len, b, b.writeLiteral(0, "down"))) return 4;
    if (editorEqual(key, len, b, b.writeLiteral(0, "pgup"))) return 5;
    if (editorEqual(key, len, b, b.writeLiteral(0, "pgdn"))) return 6;
    if (editorEqual(key, len, b, b.writeLiteral(0, "home"))) return 7;
    if (editorEqual(key, len, b, b.writeLiteral(0, "end"))) return 8;
    if (editorEqual(key, len, b, b.writeLiteral(0, "backspace"))) return 9;
    if (editorEqual(key, len, b, b.writeLiteral(0, "del"))) return 10;
    if (editorEqual(key, len, b, b.writeLiteral(0, "enter"))) return 11;
    if (editorEqual(key, len, b, b.writeLiteral(0, "tab"))) return 12;
    if (editorEqual(key, len, b, b.writeLiteral(0, "f2"))) return 13;
    if (editorEqual(key, len, b, b.writeLiteral(0, "f5"))) return 14;
    if (editorEqual(key, len, b, b.writeLiteral(0, "esc"))) return 15;
    if (editorEqual(key, len, b, b.writeLiteral(0, "f3"))) return 16;
    if (editorEqual(key, len, b, b.writeLiteral(0, "f4"))) return 17;
    if (editorEqual(key, len, b, b.writeLiteral(0, "f6"))) return 18;
    return 0;
}

function editorChange(state: WorldState): i32 {
    state.dirty = true;
    if (state.writeToken > 0) { state.changedSinceSave = true; }
    state.discardArmed = false;
    state.goal = -1;
    return 0;
}

function editorMakeRoom(doc: buffer, state: WorldState, count: i32): bool {
    if (state.textLength + count > doc.length) { state.notice = 5; }
    if (state.textLength + count > doc.length) return false;
    state.frameLast = editorInvalidateRows(state, state.lineStart);
    typedSdkMove(doc, state.cursor + count, state.cursor, state.textLength - state.cursor);
    state.textLength = state.textLength + count;
    editorChange(state);
    return true;
}

function editorInsert(state: WorldState, text: string, unit: i32, count: i32): i32 {
    if (typedSdkCodePoints(text, state.lineStart, state.lineEnd) + count > 4000) { state.notice = 4; }
    if (state.notice === 4) return 0;
    const doc = typedSdkBuffer(0);
    if (!editorMakeRoom(doc, state, count)) return 0;
    doc.setCharCodeAt(state.cursor, unit);
    if (count === 2) { doc.setCharCodeAt(state.cursor + 1, unit); }
    state.cursor = state.cursor + count;
    return 0;
}

function editorDelete(state: WorldState, from: i32, end: i32): i32 {
    if (end <= from) return 0;
    let affected = state.lineStart;
    if (from < affected) {
        const text = typedSdkView(typedSdkBuffer(0), state.textLength);
        const newline = typedSdkLastIndex(text, 0, from, 10);
        affected = 0;
        if (newline < from) { affected = newline + 1; }
    }
    state.frameLast = editorInvalidateRows(state, affected);
    typedSdkMove(typedSdkBuffer(0), from, end, state.textLength - end);
    state.textLength = state.textLength - end + from;
    state.cursor = from;
    return editorChange(state);
}

function editorContinueList(state: WorldState, text: string, first: i32, end: i32): i32 {
    const body = editorMdSpace(text, end, state.cursor);
    if (body === state.cursor && state.cursor === state.lineEnd)
        return editorDelete(state, state.lineStart, state.lineEnd);
    const indent = first - state.lineStart;
    const marker = typedSdkBuffer(7);
    if (end - first >= marker.length - 2) { state.notice = 4; }
    if (state.notice === 4) return 0;
    let size = 2;
    if (end - first === 1) {
        marker.setCharCodeAt(0, text.charCodeAt(first));
        marker.setCharCodeAt(1, 32);
    }
    if (end - first > 1) { size = editorMdNextMarker(text, first, end, marker); }
    const doc = typedSdkBuffer(0);
    if (!editorMakeRoom(doc, state, 1 + indent + size)) return 0;
    doc.setCharCodeAt(state.cursor, 10);
    typedSdkMove(doc, state.cursor + 1, state.lineStart, indent);
    let i = 0;
    while (i < size) {
        doc.setCharCodeAt(state.cursor + 1 + indent + i, marker.charCodeAt(i));
        i = i + 1;
    }
    state.cursor = state.cursor + 1 + indent + size;
    return 0;
}

function editorSplit(state: WorldState, text: string): i32 {
    const end = editorMdSpace(text, state.lineStart, state.cursor);
    const marker = editorMdListEnd(text, end, state.cursor);
    if (state.markdown && marker > 0) return editorContinueList(state, text, end, marker);
    const count = end - state.lineStart;
    const doc = typedSdkBuffer(0);
    if (!editorMakeRoom(doc, state, count + 1)) return 0;
    doc.setCharCodeAt(state.cursor, 10);
    typedSdkMove(doc, state.cursor + 1, state.lineStart, count);
    state.cursor = state.cursor + count + 1;
    return 0;
}

function editorMoveRow(state: WorldState, text: string, column: i32, delta: i32): i32 {
    if (state.goal < 0) { state.goal = column; }
    const wanted = Math.max(0, state.row + delta);
    const missed = wanted < state.row && (wanted < state.frameFirst || wanted > state.frameLast);
    if (missed) {
        editorResetRows(state);
        state.moveTarget = wanted + 1;
    }
    if (missed) return 0;
    if (wanted < state.row) { editorFrameRow(text, state, wanted); }
    while (state.row < wanted && editorNextRow(text, state)) {}
    state.cursor = editorOffset(text, state.rowStart, state.rowEnd, state.lineEnd, state.goal);
    return 0;
}

function editorJump(state: WorldState): i32 {
    if (state.cursor === 0) return state.textLength;
    return 0;
}

function editorPlainKey(state: WorldState, key: i32, ch: i32): i32 {
    const text = typedSdkView(typedSdkBuffer(0), state.textLength);
    const column = editorLocate(text, state);
    if (key === 3) return editorMoveRow(state, text, column, -1);
    if (key === 4) return editorMoveRow(state, text, column, 1);
    if (key === 5) return editorMoveRow(state, text, column, -16);
    if (key === 6) return editorMoveRow(state, text, column, 16);
    state.goal = -1;
    if (key === 1) { state.cursor = editorPrevious(text, state.cursor); }
    if (key === 2) { state.cursor = editorNext(text, state.cursor); }
    if (key === 7) { state.cursor = state.rowStart; }
    if (key === 8) { state.cursor = editorOffset(text, state.rowStart, state.rowEnd, state.lineEnd, 49); }
    if (key === 9) return editorDelete(state, editorPrevious(text, state.cursor), state.cursor);
    if (key === 10) return editorDelete(state, state.cursor, editorNext(text, state.cursor));
    if (key === 11) return editorSplit(state, text);
    if (key === 12) return editorInsert(state, text, 32, 2);
    if (key === 14) { state.cursor = editorJump(state); }
    if (key === 0 && ch >= 32 && !(ch === 127) && !(ch >= 55296 && ch <= 57343))
        return editorInsert(state, text, ch, 1);
    return 0;
}

function editorSave(state: WorldState): i32 {
    state.notice = 1;
    if (state.writeToken > 0) return 0;
    const slot = 1 - state.savedSlot;
    const bytes = typedSdkCapture(slot, typedSdkBuffer(0), state.textLength);
    if (bytes < 0) { state.notice = 5; }
    if (bytes < 0) return 0;
    const token = typedSdkWriteSnapshot(state.file, slot);
    if (token <= 0) {
        state.notice = 3;
        state.errorLength = typedSdkError(typedSdkBuffer(4));
    }
    if (token <= 0) return 0;
    state.writeToken = token;
    state.changedSinceSave = false;
    return 0;
}

function editorGoFiles(output: buffer): i32 {
    const to = typedSdkBuffer(2);
    const kind = typedSdkBuffer(3);
    return typedSdkSend(to, to.writeLiteral(0, "compositor"), kind, kind.writeLiteral(0, "open"),
        output, output.writeLiteral(0, "{\"app\":\"files\"}"));
}

function editorDiscard(state: WorldState, output: buffer): i32 {
    const length = typedSdkRestore(state.savedSlot, typedSdkBuffer(0));
    if (length < 0) return 0;
    state.textLength = length;
    editorResetRows(state);
    state.cursor = 0;
    state.top = 0;
    state.goal = -1;
    state.dirty = false;
    state.discardArmed = false;
    state.notice = 8;
    state.finding = false;
    state.queryLength = 0;
    state.preview = false;
    editorRemember(state, output);
    return editorGoFiles(output);
}

function editorEscape(state: WorldState, output: buffer): i32 {
    if (state.writeToken > 0) {
        state.leaveAfterSave = true;
        state.notice = 6;
    }
    if (state.writeToken > 0) return 0;
    if (state.dirty && state.discardArmed) return editorDiscard(state, output);
    if (state.dirty) {
        state.discardArmed = true;
        state.notice = 7;
    }
    if (state.dirty) return 0;
    editorRemember(state, output);
    return editorGoFiles(output);
}

function editorApplyKey(state: WorldState, action: i32, ch: i32, held: bool, output: buffer): i32 {
    if (state.file <= 0 && action === 15 && !held) return editorGoFiles(output);
    if (state.file <= 0) return 0;
    if (state.preview) return editorPreviewKey(state, action, held);
    if (state.finding) return editorFindInput(state, action, ch, held);
    state.notice = 0;
    if (held && action >= 13) return 0;
    if (action === 16) return editorBeginFind(state);
    if (action === 17) return editorFindNext(state, true);
    if (action === 18) return editorBeginPreview(state);
    if (action === 13) return editorSave(state);
    if (action === 15) return editorEscape(state, output);
    return editorPlainKey(state, action, ch);
}

function editorInput(state: WorldState, output: buffer, hints: buffer): i32 {
    const key = typedSdkBuffer(3);
    const reference = typedSdkBuffer(2);
    let n = typedSdkEventText(0, key, 0, key);
    if (!editorEqual(key, n, reference, reference.writeLiteral(0, "key"))) return 0;
    n = typedSdkEventText(1, key, 0, key);
    if (!editorEqual(key, n, reference, reference.writeLiteral(0, "compositor"))) return 0;
    n = typedSdkEventText(3, reference, reference.writeLiteral(0, "state"), key);
    if (editorEqual(key, n, reference, reference.writeLiteral(0, "up"))) return 0;
    const held = editorEqual(key, n, reference, reference.writeLiteral(0, "hold"));
    n = typedSdkEventText(3, reference, reference.writeLiteral(0, "key"), key);
    const action = editorKeyCode(key, n, reference);
    n = typedSdkEventText(3, reference, reference.writeLiteral(0, "ch"), key);
    let ch = 0;
    if (n === 1) { ch = key.charCodeAt(0); }
    if (state.frameToken > 0) {
        state.frameToken = 0;
        state.frameRow = 0;
        state.moveTarget = 0;
    }
    if (action === 15 && !held && !state.preview && !state.finding && !state.dirty && state.writeToken === 0)
        return editorEscape(state, output);
    editorApplyKey(state, action, ch, held, output);
    if (state.file > 0) return editorShow(output, hints, state);
    return 0;
}

function editorWriteDone(event: WorldEvent, state: WorldState, output: buffer, hints: buffer): i32 {
    state.writeToken = 0;
    state.notice = 3;
    const scratch = typedSdkBuffer(3);
    if (!event.ok) { state.errorLength = typedSdkEventText(2, scratch, 0, typedSdkBuffer(4)); }
    if (event.ok) {
        state.savedSlot = 1 - state.savedSlot;
        state.dirty = state.changedSinceSave &&
            typedSdkMatches(state.savedSlot, typedSdkBuffer(0), state.textLength) === 0;
        if (!state.dirty) { state.discardArmed = false; }
        state.savedBytes = Math.max(0, typedSdkEventInt(scratch, scratch.writeLiteral(0, "bytes")));
        state.notice = 2;
        editorRemember(state, output);
        if (state.leaveAfterSave && !state.dirty) { editorGoFiles(output); }
    }
    state.leaveAfterSave = false;
    return editorShow(output, hints, state);
}
