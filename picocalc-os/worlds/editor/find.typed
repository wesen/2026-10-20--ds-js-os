function editorFindMatch(text: string, at: i32, end: i32, query: buffer, size: i32): bool {
    if (end - at < size) return false;
    let i = 0;
    while (i < size && editorFold(text.charCodeAt(at + i)) === editorFold(query.charCodeAt(i)) &&
        (!(text.charCodeAt(at + i) === 304) || i + 1 === size)) { i = i + 1; }
    return i === size;
}

function editorSetFound(state: WorldState, text: string, first: i32, end: i32, found: i32): i32 {
    let at = Math.min(end, first + found);
    if (at > first && at < end && editorLowSurrogate(text.charCodeAt(at)) &&
        editorHighSurrogate(text.charCodeAt(at - 1))) { at = at + 1; }
    state.cursor = at;
    state.goal = -1;
    state.notice = 0;
    return 0;
}

function editorFindLine(state: WorldState, text: string, start: i32): i32 {
    state.findStart = start;
    state.findEnd = editorLineEnd(text, start);
    state.findAt = start;
    state.findFolded = 0;
    return 0;
}

// Visit the cursor line suffix, following lines, preceding lines, and
// finally the cursor line prefix. A prefix match may cross the origin.
function editorFindAdvance(state: WorldState, text: string): i32 {
    if (state.findPhase === 3) { state.findPhase = 4; }
    if (state.findPhase === 4) return 0;
    const next = state.findEnd + 1;
    if (state.findPhase === 0) { state.findPhase = 1; }
    if (state.findPhase === 1 && next < text.length) return editorFindLine(state, text, next);
    const wraps = state.findPhase === 1 && state.findOrigin > 0;
    if (wraps) { state.findPhase = 2; }
    if (wraps) return editorFindLine(state, text, 0);
    if (state.findPhase === 2 && next < state.findOrigin) return editorFindLine(state, text, next);
    state.findPhase = 3;
    return editorFindLine(state, text, state.findOrigin);
}

function editorFindStep(state: WorldState, text: string): i32 {
    const query = typedSdkBuffer(6);
    const size = state.queryLength;
    const low = editorFold(query.charCodeAt(0));
    let upper = low;
    if (low >= 97 && low <= 122) { upper = low - 32; }
    let alternate = low;
    if (low === 107) { alternate = 8490; }
    let work = 0;
    while (state.findPhase < 4 && work < 1024) {
        work = work + 1;
        let candidate = state.findEnd;
        if (state.findAt < state.findEnd) {
            candidate = typedSdkSeek(text, state.findAt, state.findEnd, low, upper, alternate, 304);
        }
        const folded = state.findFolded + candidate - state.findAt;
        let limit = state.findEnd;
        if (state.findPhase === 3 && folded >= state.findFrom) { limit = candidate; }
        if (candidate >= limit) { editorFindAdvance(state, text); }
        if (candidate < limit) {
            const eligible = state.findPhase > 0 || folded >= state.findFrom;
            const unit = text.charCodeAt(candidate);
            state.findAt = candidate + 1;
            state.findFolded = folded + 1;
            if (unit === 304) { state.findFolded = state.findFolded + 1; }
            if (eligible) { work = work + size; }
            const found = eligible && editorFindMatch(text, candidate, state.findEnd, query, size);
            if (found) { editorSetFound(state, text, state.findStart, state.findEnd, folded); }
            if (found) { state.findPhase = 5; }
        }
    }
    if (state.findPhase === 4) { state.notice = 10; }
    if (state.findPhase >= 4) return 0;
    state.findToken = typedSdkYield();
    if (state.findToken <= 0) { state.notice = 11; }
    return 0;
}

function editorFindNext(state: WorldState, advance: bool): i32 {
    if (state.queryLength <= 0 && advance) { state.notice = 9; }
    if (state.queryLength <= 0) return 0;
    const text = typedSdkView(typedSdkBuffer(0), state.textLength);
    const newline = typedSdkLastIndex(text, 0, state.cursor, 10);
    state.findOrigin = 0;
    if (newline < state.cursor) { state.findOrigin = newline + 1; }
    state.findPhase = 0;
    editorFindLine(state, text, state.findOrigin);
    state.findFrom = state.cursor - state.findOrigin;
    if (advance) { state.findFrom = Math.min(state.findEnd, editorNext(text, state.cursor)) - state.findOrigin; }
    return editorFindStep(state, text);
}

function editorFindInput(state: WorldState, key: i32, ch: i32, held: bool): i32 {
    if (key === 15 && !held) {
        state.finding = false;
        state.queryLength = 0;
        state.notice = 0;
    }
    if (!state.finding) return 0;
    if (key === 11 && !held) {
        state.finding = false;
        state.notice = 0;
    }
    if (!state.finding) return editorFindNext(state, false);
    if (key === 9) {
        state.queryLength = Math.max(0, state.queryLength - 1);
    }
    if (key === 9 || ch < 32 || ch > 126 || state.queryLength >= 60) return 0;
    const query = typedSdkBuffer(6);
    query.setCharCodeAt(state.queryLength, ch);
    state.queryLength = state.queryLength + 1;
    return 0;
}

function editorBeginFind(state: WorldState): i32 {
    state.finding = true;
    return 0;
}

function editorFindStatus(buf: buffer, state: WorldState): i32 {
    let at = 0;
    if (state.finding) { at = buf.writeLiteral(0, "Find: "); }
    if (!state.finding) { at = buf.writeLiteral(0, "Not found: "); }
    const query = typedSdkBuffer(6);
    let i = 0;
    while (i < state.queryLength) {
        buf.setCharCodeAt(at, query.charCodeAt(i));
        at = at + 1;
        i = i + 1;
    }
    if (state.finding) { at = at + buf.writeLiteral(at, "_"); }
    return at;
}

function editorFindMark(out: buffer, offset: i32, row: i32, col: i32, size: i32): i32 {
    let at = offset + out.writeLiteral(offset, "[");
    at = editorDigits(out, at, row);
    out.setCharCodeAt(at, 44);
    at = editorDigits(out, at + 1, col);
    out.setCharCodeAt(at, 44);
    at = editorDigits(out, at + 1, size);
    return at + out.writeLiteral(at, ",\"soft\"]");
}

function editorFindMarks(out: buffer, offset: i32, text: string, state: WorldState): i32 {
    if (state.queryLength <= 0) return offset;
    let at = offset;
    const query = typedSdkBuffer(6);
    editorFrameRow(text, state, state.top);
    let row = 0;
    let more = true;
    while (row < 17 && more) {
        const start = state.rowStart;
        const end = state.rowEnd;
        let pos = start;
        let folded = 0;
        while (pos < end) {
            if (editorFindMatch(text, pos, end, query, state.queryLength)) {
                if (at > offset) { at = at + out.writeLiteral(at, ","); }
                at = editorFindMark(out, at, row, editorColumn(text, start, Math.min(end, start + folded)), state.queryLength);
            }
            if (text.charCodeAt(pos) === 304) { folded = folded + 1; }
            pos = pos + 1;
            folded = folded + 1;
        }
        more = editorNextRow(text, state);
        row = row + 1;
    }
    return at;
}
