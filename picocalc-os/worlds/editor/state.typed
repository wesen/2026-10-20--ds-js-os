record WorldEvent {
    kind: i32;
    ask: bool;
    token: i32;
    ok: bool;
}

record WorldState {
    file: i32;
    offered: i32;
    offeredNameLength: i32;
    readToken: i32;
    nameLength: i32;
    textLength: i32;
    reading: bool;
    sourceLength: i32;
    unitsRead: i32;
    unitsWritten: i32;
    cursor: i32;
    top: i32;
    goal: i32;
    row: i32;
    line: i32;
    rowStart: i32;
    rowEnd: i32;
    lineStart: i32;
    lineEnd: i32;
    dirty: bool;
    savedSlot: i32;
    discardArmed: bool;
    writeToken: i32;
    savedBytes: i32;
    errorLength: i32;
    notice: i32;
    leaveAfterSave: bool;
    positionLine: i32;
    positionColumn: i32;
    positionTop: i32;
    positionTime: i32;
    positionEnd: i32;
}
