record WorldEvent {
    kind: i32;
    ask: bool;
    token: i32;
    ok: bool;
}

record WorldState {
    file: i32;
    offered: i32;
    offeredNameLength: i32;
    readToken: i32;
    nameLength: i32;
    textLength: i32;
    reading: bool;
    sourceLength: i32;
    unitsRead: i32;
    unitsWritten: i32;
    cursor: i32;
    top: i32;
    goal: i32;
    row: i32;
    line: i32;
    rowStart: i32;
    rowEnd: i32;
    lineStart: i32;
    lineEnd: i32;
    fenced: bool;
    frameRow: i32;
    frameToken: i32;
    frameFirst: i32;
    frameLast: i32;
    moveTarget: i32;
    openFrame: bool;
    dirty: bool;
    savedSlot: i32;
    discardArmed: bool;
    writeToken: i32;
    changedSinceSave: bool;
    savedBytes: i32;
    errorLength: i32;
    notice: i32;
    leaveAfterSave: bool;
    positionLine: i32;
    positionColumn: i32;
    positionTop: i32;
    positionTime: i32;
    positionEnd: i32;
    finding: bool;
    queryLength: i32;
    findToken: i32;
    findPhase: i32;
    findOrigin: i32;
    findFrom: i32;
    findStart: i32;
    findEnd: i32;
    findAt: i32;
    findFolded: i32;
    markdown: bool;
    preview: bool;
    previewTop: i32;
    previewParagraph: bool;
    previewFence: bool;
    previewOffset: i32;
    previewRows: i32;
    previewUnits: i32;
    previewColumns: i32;
    previewToken: i32;
    previewKind: i32;
    previewFromDocument: bool;
    previewAt: i32;
    previewEnd: i32;
    mdPass: i32;
    mdStart: i32;
    mdSize: i32;
    mdRead: i32;
    mdWrite: i32;
    mdProbe: i32;
    mdClose: i32;
}
