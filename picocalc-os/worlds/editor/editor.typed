// Fields follow the shared typed runtime's metadata contract.
function typedWorldMeta(field: i32, output: buffer): i32 {
    if (field === 0) return output.writeLiteral(0, "app");
    if (field === 1) return output.writeLiteral(0, "Editor");
    if (field === 2) return output.writeLiteral(0, "e");
    if (field === 3) return output.writeLiteral(0, "Plain text and Markdown, with find, soft wrap and a preview.");
    if (field === 4) return output.writeLiteral(0, "[[\"rect\",8,0,24,30],[\"fill\",12,6,16,2],[\"fill\",12,12,16,2],[\"fill\",12,18,9,2],[\"fill\",23,16,2,7,\"accent\"]]");
    return 0;
}


function editorReplyError(output: buffer, error: string): i32 {
    let at = output.writeLiteral(0, "{\"ok\":false,\"why\":");
    at = editorQuote(output, at, error, 0, error.length);
    return typedSdkReply(output, at + output.writeLiteral(at, "}"));
}

function editorRefuseOpen(state: WorldState, handle: i32, output: buffer): i32 {
    typedSdkRelease(handle);
    const reason = typedSdkBuffer(3);
    if (!state.dirty)
        return editorReplyError(output, typedSdkView(reason, reason.writeLiteral(0, "The editor is saving.")));
    const name = typedSdkBuffer(1);
    const end = reason.writeLiteral(0, "the editor has unsaved changes to ");
    let i = 0;
    while (i < state.nameLength) {
        reason.setCharCodeAt(end + i, name.charCodeAt(i));
        i = i + 1;
    }
    return editorReplyError(output, typedSdkView(reason, end + i));
}

function editorOpen(event: WorldEvent, state: WorldState, output: buffer, hints: buffer): i32 {
    const scratch = typedSdkBuffer(3);
    let n = typedSdkEventText(0, scratch, 0, scratch);
    if (!(n === 4)) return 0;
    if (!(scratch.charCodeAt(0) === 111 && scratch.charCodeAt(1) === 112 &&
        scratch.charCodeAt(2) === 101 && scratch.charCodeAt(3) === 110)) return 0;
    n = scratch.writeLiteral(0, "file");
    const handle = typedSdkEventHandle(scratch, n);
    if (handle <= 0) {
        typedSdkReply(output, output.writeLiteral(0, "{\"ok\":false,\"why\":\"No file handle.\"}"));
    }
    if (handle <= 0) return 0;
    if (state.dirty || state.writeToken > 0) return editorRefuseOpen(state, handle, output);
    if (state.opening) {
        typedSdkRelease(handle);
        return typedSdkReply(output, output.writeLiteral(0, "{\"ok\":false,\"why\":\"The editor is opening a file.\"}"));
    }
    const pendingName = typedSdkBuffer(2);
    n = scratch.writeLiteral(0, "name");
    let size = typedSdkEventText(3, scratch, n, pendingName);
    if (size < 1 || size > 95) { size = pendingName.writeLiteral(0, "untitled"); }
    // The title uses at most units 0 through 94 of its reserved buffer.
    pendingName.setCharCodeAt(95, size);
    state.opening = true;
    start editorOpenTask(event, state, output, hints, handle);
    if (state.opening) return 1;
    return 0;
}

function editorOpened(state: WorldState, handle: i32, size: i32, output: buffer, hints: buffer): i32 {
    if (state.file > 0 && state.file !== handle) { typedSdkRelease(state.file); }
    state.file = handle;
    state.opening = false;
    state.textLength = size;
    state.savedSlot = 0;
    typedSdkCapture(state.savedSlot, typedSdkBuffer(0), state.textLength);
    const pendingName = typedSdkBuffer(2);
    const nameLength = pendingName.charCodeAt(95);
    const name = typedSdkBuffer(1);
    let n = 0;
    while (n < nameLength) {
        name.setCharCodeAt(n, pendingName.charCodeAt(n));
        n = n + 1;
    }
    state.nameLength = n;
    state.markdown = editorIsMarkdown(state);
    state.preview = false;
    state.previewToken = 0;
    state.frameToken = 0;
    editorResetRows(state);
    state.moveTarget = 0;
    state.openFrame = true;
    state.cursor = 0;
    state.top = 0;
    state.goal = -1;
    state.dirty = false;
    state.discardArmed = false;
    state.finding = false;
    state.queryLength = 0;
    state.notice = 0;
    if (size > 4096) { state.frameToken = typedSdkYield(); }
    if (state.frameToken > 0) return 0;
    editorRestorePosition(state);
    return editorShow(output, hints, state);
}

function editorOpenFailed(state: WorldState, handle: i32, output: buffer, error: buffer, length: i32): i32 {
    state.opening = false;
    typedSdkRelease(handle);
    if (length < 0) return typedSdkReply(output, output.writeLiteral(0, "{\"ok\":false,\"why\":\"Invalid file response.\"}"));
    return editorReplyError(output, typedSdkView(error, length));
}

async function editorOpenTask(event: WorldEvent, state: WorldState, output: buffer, hints: buffer, handle: i32): i32 {
    const ok = await typedSdkFileRead(handle);
    if (!ok) {
        if (event.kind === 0) {
            state.opening = false;
            typedSdkRelease(handle);
            return typedSdkReply(output, output.writeLiteral(0, "{\"ok\":false,\"why\":\"Cannot read file.\"}"));
        }
        const error = typedSdkBuffer(3);
        const size = typedSdkEventText(2, output, 0, error);
        const prefix = output.writeLiteral(0, "no file");
        if (size >= prefix && editorEqual(error, prefix, output, prefix)) {
            editorRemember(state, output);
            return editorOpened(state, handle, 0, output, hints);
        }
        return editorOpenFailed(state, handle, output, error, size);
    }
    editorRemember(state, output);
    const length = typedSdkEventText(2, output, 0, typedSdkBuffer(0));
    if (length < 0) return editorOpenFailed(state, handle, output, output, -1);
    let read = 0;
    let written = 0;
    while (read < length) {
        // Yield before the first slice of a large read and between slices.
        if (length > 4096) {
            const paused = await typedSdkYield();
            if (!paused) return editorOpenFailed(state, handle, output, output, -1);
        }
        const text = typedSdkBuffer(0);
        const stop = Math.min(length, read + 4096);
        while (read < stop) {
            let unit = text.charCodeAt(read);
            read = read + 1;
            if (unit === 13) {
                unit = 10;
                if (read < length && text.charCodeAt(read) === 10) { read = read + 1; }
            }
            text.setCharCodeAt(written, unit);
            written = written + 1;
        }
    }
    return editorOpened(state, handle, written, output, hints);
}

function typedWorldEvent(event: WorldEvent, state: WorldState, output: buffer, hints: buffer): i32 {
    if (event.kind === 0 && event.ask) return editorOpen(event, state, output, hints);
    if (event.kind === 0 && !state.opening) { editorInput(state, output, hints); }
    if (event.kind === 4 && state.writeToken > 0 && event.token === state.writeToken) {
        editorWriteDone(event, state, output, hints);
    }
    resume();
    if (event.kind === 4 && state.previewToken > 0 && event.token === state.previewToken) {
        state.previewToken = 0;
        if (state.preview && !state.opening) { editorShow(output, hints, state); }
    }
    if (event.kind === 4 && state.findToken > 0 && event.token === state.findToken) {
        state.findToken = 0;
        editorFindStep(state, typedSdkView(typedSdkBuffer(0), state.textLength));
        editorShow(output, hints, state);
    }
    if (event.kind === 4 && state.frameToken > 0 && event.token === state.frameToken) {
        state.frameToken = 0;
        if (state.openFrame && state.frameRow === 0) { editorRestorePosition(state); }
        editorShow(output, hints, state);
    }
    if (event.kind === 2) {
        const hintLength = hints.writeLiteral(0, "Esc Files");
        typedSdkScreen(output, editorEmptyFrame(output), hints, hintLength);
    }
    if (pending() || state.findToken > 0 || state.frameToken > 0) return 1;
    return 0;
}
