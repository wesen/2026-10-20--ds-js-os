// The caller supplies a validated Candela v1 graph and disjoint buffers.
// work[0] selects the pixel stride. Zero means the 160-cell default.
function typedRayMaterialFrame(pixels: buffer, work: buffer, graph: buffer,
        shaderWork: buffer, rowMaterials: buffer, rowColors: buffer,
        lightX: i32, lightY: i32): i32 {
    if (!candelaHeader(graph) || work.length < 2048 || shaderWork.length < 192 ||
        rowMaterials.length < 160 || rowColors.length < 320 ||
        lightX < 0 || lightX > 159 || lightY < 0 || lightY > 159) return 0;
    let stride = work.charCodeAt(0);
    if (stride === 0) { stride = 160; }
    if (stride < 160 || stride > 320 || pixels.length < 159 * stride + 160) return 0;
    const count = graph.charCodeAt(4);
    const floorMaterial = graph.charCodeAt(6);
    work.setCharCodeAt(16, count);
    for (let sphere = 0; sphere < count; sphere = sphere + 1) {
        for (let field = 0; field < 5; field = field + 1) {
            work.setCharCodeAt(1 + 5 * sphere + field, graph.charCodeAt(280 + 5 * sphere + field));
        }
    }
    typedRayBuildTables(work, lightX, lightY);
    for (let y = 0; y < 160; y = y + 1) {
        typedRayComputeRow(work, y);
        for (let x = 0; x < 160; x = x + 1) {
            let material = floorMaterial;
            if (work.charCodeAt(1545 + x) !== 0) {
                const id = work.charCodeAt(1705 + x);
                material = work.charCodeAt(5 + 5 * (id - 1));
            }
            rowMaterials.setCharCodeAt(x, material);
        }
        if (candelaShadeRow(graph, shaderWork, rowMaterials, y, rowColors) !== 160) return 0;
        for (let x = 0; x < 160; x = x + 1) {
            const depth = work.charCodeAt(1545 + x);
            let scale = 255;
            if (depth !== 0) {
                scale = typedRaySphereScale(work, work.charCodeAt(1705 + x) - 1, depth, x, y);
            } else if (typedRayInShadow(work, x, y)) {
                scale = 85;
            }
            const rg = rowColors.charCodeAt(2 * x);
            const blue = rowColors.charCodeAt(2 * x + 1);
            pixels.setCharCodeAt(stride * y + x, typedRayPack(rg / 256, rg % 256, blue, scale));
        }
    }
    return 1;
}
