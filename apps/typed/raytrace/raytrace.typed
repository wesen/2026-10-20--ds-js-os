// Complete scalar reference for the maintained 160 x 160 orthographic scene.
// All frame data is RGB565 or uint16 audit values. Scratch cell 0 supplies stride.
function typedRayStride(work: buffer): i32 {
    if (work.length < 2048) return 0;
    const stride = work.charCodeAt(0);
    if (stride === 0) return 160;
    if (stride < 160 || stride > 320) return 0;
    return stride;
}

function typedRaySphereFits(x: i32, y: i32): bool {
    return x >= 32 && x <= 127 && y >= 32 && y <= 127;
}

function typedRayLampFits(x: i32, y: i32): bool {
    return x >= 0 && x < 160 && y >= 0 && y < 160;
}

function typedRayAbs(value: i32): i32 {
    if (value < 0) return -value;
    return value;
}

function typedRaySetObject(work: buffer, index: i32, x: i32, y: i32, z: i32, radius: i32, material: i32): i32 {
    const at = 1 + 5 * index;
    work.setCharCodeAt(at, x);
    work.setCharCodeAt(at + 1, y);
    work.setCharCodeAt(at + 2, z);
    work.setCharCodeAt(at + 3, radius);
    work.setCharCodeAt(at + 4, material);
    return 1;
}

function typedRaySetObjects(work: buffer, sphereX: i32, sphereY: i32): i32 {
    work.setCharCodeAt(16, 3);
    typedRaySetObject(work, 0, sphereX, sphereY, 56, 26, 0);
    typedRaySetObject(work, 1, 100, 65, 105, 32, 1);
    typedRaySetObject(work, 2, 58, 109, 86, 23, 2);
    return 1;
}

function typedRayBuildGeometry(work: buffer): i32 {
    const count = work.charCodeAt(16);
    for (let sphere = 0; sphere < count; sphere = sphere + 1) {
        const cx = work.charCodeAt(1 + 5 * sphere);
        const row = 40 + 160 * sphere;
        for (let x = 0; x < 160; x = x + 1) {
            const dx = x - cx;
            work.setCharCodeAt(row + x, dx * dx);
        }
    }
    let root = 0;
    let next = 1;
    for (let d = 0; d <= 1024; d = d + 1) {
        if (d === next) {
            root = root + 1;
            next = next + 2 * root + 1;
        }
        work.setCharCodeAt(520 + d, root);
    }
    return 1;
}

function typedRayBuildLight(work: buffer, lightX: i32, lightY: i32): i32 {
    const lx = (lightX - 80) * 3 / 10;
    const ly = (lightY - 80) * 3 / 10;
    const normSquared = lx * lx + ly * ly + 1024;
    let norm = 32;
    while ((norm + 1) * (norm + 1) <= normSquared) { norm = norm + 1; }
    work.setCharCodeAt(17, lx + 32);
    work.setCharCodeAt(18, ly + 32);
    work.setCharCodeAt(19, normSquared);
    work.setCharCodeAt(20, norm);

    const count = work.charCodeAt(16);
    for (let sphere = 0; sphere < count; sphere = sphere + 1) {
        const object = 1 + 5 * sphere;
        const shadow = 21 + 4 * sphere;
        const dz = 156 - work.charCodeAt(object + 2);
        const radius = work.charCodeAt(object + 3);
        work.setCharCodeAt(shadow, 4096 + 32 * work.charCodeAt(object) - dz * lx);
        work.setCharCodeAt(shadow + 1, 4096 + 32 * work.charCodeAt(object + 1) - dz * ly);
        work.setCharCodeAt(shadow + 2, radius * (32 + typedRayAbs(lx)));
        work.setCharCodeAt(shadow + 3, radius * (32 + typedRayAbs(ly)));
    }
    return 1;
}

function typedRayBuildTables(work: buffer, lightX: i32, lightY: i32): i32 {
    typedRayBuildGeometry(work);
    return typedRayBuildLight(work, lightX, lightY);
}

function typedRayPrepare(work: buffer, sphereX: i32, sphereY: i32, lightX: i32, lightY: i32): i32 {
    typedRaySetObjects(work, sphereX, sphereY);
    return typedRayBuildTables(work, lightX, lightY);
}

function typedRayComputeRow(work: buffer, y: i32): i32 {
    for (let x = 0; x < 160; x = x + 1) {
        work.setCharCodeAt(1545 + x, 0);
        work.setCharCodeAt(1705 + x, 0);
    }
    const count = work.charCodeAt(16);
    for (let sphere = 0; sphere < count; sphere = sphere + 1) {
        const object = 1 + 5 * sphere;
        const dy = y - work.charCodeAt(object + 1);
        const cz = work.charCodeAt(object + 2);
        const radius = work.charCodeAt(object + 3);
        const row = radius * radius - dy * dy;
        const horizontal = 40 + sphere * 160;
        for (let x = 0; x < 160; x = x + 1) {
            const discriminant = row - work.charCodeAt(horizontal + x);
            if (discriminant >= 0) {
                const depth = cz - work.charCodeAt(520 + discriminant);
                const previous = work.charCodeAt(1545 + x);
                if (previous === 0 || depth < previous) {
                    work.setCharCodeAt(1545 + x, depth);
                    work.setCharCodeAt(1705 + x, sphere + 1);
                }
            }
        }
    }
    return 1;
}

function typedRayInShadow(work: buffer, x: i32, y: i32): bool {
    const lx = work.charCodeAt(17) - 32;
    const ly = work.charCodeAt(18) - 32;
    const norm = work.charCodeAt(19);
    const count = work.charCodeAt(16);
    const scaledX = 4096 + 32 * x;
    const scaledY = 4096 + 32 * y;
    for (let sphere = 0; sphere < count; sphere = sphere + 1) {
        const shadow = 21 + 4 * sphere;
        if (typedRayAbs(scaledX - work.charCodeAt(shadow)) <= work.charCodeAt(shadow + 2) &&
            typedRayAbs(scaledY - work.charCodeAt(shadow + 1)) <= work.charCodeAt(shadow + 3)) {
            const object = 1 + 5 * sphere;
            const dx = work.charCodeAt(object) - x;
            const dy = work.charCodeAt(object + 1) - y;
            const dz = 156 - work.charCodeAt(object + 2);
            const radius = work.charCodeAt(object + 3);
            const dot = dx * lx + dy * ly + 32 * dz;
            const distance = dx * dx + dy * dy + dz * dz - radius * radius;
            if (dot > 0 && distance * norm <= dot * dot) return true;
        }
    }
    return false;
}

function typedRaySphereScale(work: buffer, sphere: i32, depth: i32, x: i32, y: i32): i32 {
    const object = 1 + 5 * sphere;
    const lx = work.charCodeAt(17) - 32;
    const ly = work.charCodeAt(18) - 32;
    const height = work.charCodeAt(object + 2) - depth;
    const dot = (x - work.charCodeAt(object)) * lx + (y - work.charCodeAt(object + 1)) * ly + 32 * height;
    const bound = work.charCodeAt(object + 3) * work.charCodeAt(20);
    if (dot <= 0) return 62;
    if (dot >= bound) return 245;
    return 62 + dot * 183 / bound;
}

function typedRayPack(red: i32, green: i32, blue: i32, scale: i32): i32 {
    const r = red * scale / 255 / 8;
    const g = green * scale / 255 / 4;
    const b = blue * scale / 255 / 8;
    return 2048 * r + 32 * g + b;
}

function typedRayPixel(work: buffer, id: i32, depth: i32, x: i32, y: i32): i32 {
    if (id !== 0) {
        const scale = typedRaySphereScale(work, id - 1, depth, x, y);
        if (id === 1) return typedRayPack(245, 83, 67, scale);
        if (id === 2) return typedRayPack(48, 197, 213, scale);
        return typedRayPack(245, 182, 58, scale);
    }
    let level = 117;
    if ((x / 16 + y / 16) % 2 === 1) { level = 177; }
    if (typedRayInShadow(work, x, y)) { level = level / 3; }
    return typedRayPack(105, 134, 158, level);
}

function typedRayLitRow(pixels: buffer, work: buffer, y: i32, stride: i32): i32 {
    const row = y * stride;
    for (let x = 0; x < 160; x = x + 1) {
        const depth = work.charCodeAt(1545 + x);
        const id = work.charCodeAt(1705 + x);
        pixels.setCharCodeAt(row + x, typedRayPixel(work, id, depth, x, y));
    }
    return 1;
}

function typedRaySaveAudit(depths: buffer, ids: buffer, work: buffer, y: i32, stride: i32): i32 {
    const row = y * stride;
    for (let x = 0; x < 160; x = x + 1) {
        depths.setCharCodeAt(row + x, work.charCodeAt(1545 + x));
        ids.setCharCodeAt(row + x, work.charCodeAt(1705 + x));
    }
    return 1;
}

function typedRayFrame(pixels: buffer, work: buffer, sphereX: i32, sphereY: i32, lightX: i32, lightY: i32): i32 {
    const stride = typedRayStride(work);
    if (stride === 0 || pixels.length < 159 * stride + 160 ||
        !typedRaySphereFits(sphereX, sphereY) || !typedRayLampFits(lightX, lightY)) return 0;
    typedRayPrepare(work, sphereX, sphereY, lightX, lightY);
    for (let y = 0; y < 160; y = y + 1) {
        typedRayComputeRow(work, y);
        typedRayLitRow(pixels, work, y, stride);
    }
    return 1;
}

function typedRayRender(pixels: buffer, depths: buffer, ids: buffer, work: buffer,
                        sphereX: i32, sphereY: i32, lightX: i32, lightY: i32): i32 {
    const stride = typedRayStride(work);
    const capacity = 159 * stride + 160;
    if (stride === 0 || pixels.length < capacity || depths.length < capacity || ids.length < capacity ||
        !typedRaySphereFits(sphereX, sphereY) || !typedRayLampFits(lightX, lightY)) return 0;
    typedRayPrepare(work, sphereX, sphereY, lightX, lightY);
    for (let y = 0; y < 160; y = y + 1) {
        typedRayComputeRow(work, y);
        typedRaySaveAudit(depths, ids, work, y, stride);
        typedRayLitRow(pixels, work, y, stride);
    }
    return 1;
}

function typedRayTrace(depths: buffer, ids: buffer, work: buffer, sphereX: i32, sphereY: i32): i32 {
    const stride = typedRayStride(work);
    const capacity = 159 * stride + 160;
    if (stride === 0 || depths.length < capacity || ids.length < capacity ||
        !typedRaySphereFits(sphereX, sphereY)) return 0;
    typedRaySetObjects(work, sphereX, sphereY);
    typedRayBuildGeometry(work);
    for (let y = 0; y < 160; y = y + 1) {
        typedRayComputeRow(work, y);
        typedRaySaveAudit(depths, ids, work, y, stride);
    }
    return 1;
}

// Depth and ID inputs come from a matched trace at the same sphere position.
function typedRayShade(pixels: buffer, depths: buffer, ids: buffer, work: buffer,
                       sphereX: i32, sphereY: i32, lightX: i32, lightY: i32): i32 {
    const stride = typedRayStride(work);
    const capacity = 159 * stride + 160;
    if (stride === 0 || pixels.length < capacity || depths.length < capacity || ids.length < capacity ||
        !typedRaySphereFits(sphereX, sphereY) || !typedRayLampFits(lightX, lightY)) return 0;
    typedRaySetObjects(work, sphereX, sphereY);
    typedRayBuildLight(work, lightX, lightY);
    for (let y = 0; y < 160; y = y + 1) {
        const row = y * stride;
        for (let x = 0; x < 160; x = x + 1) {
            const depth = depths.charCodeAt(row + x);
            const id = ids.charCodeAt(row + x);
            if (id > 3 || depth > 105 || (id === 0 && depth !== 0) || (id !== 0 && depth === 0)) return 0;
            pixels.setCharCodeAt(row + x, typedRayPixel(work, id, depth, x, y));
        }
    }
    return 1;
}
