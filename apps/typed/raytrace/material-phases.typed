// These entries exist only in the diagnostic module. The clean renderer never calls them.
function typedMatBuild(graph: buffer, fixture: i32, weight: i32): i32 {
    let ok = 0;
    if (fixture === 0) { ok = candelaHandShared(graph); }
    if (fixture === 1) { ok = candelaHandTile(graph); }
    if (ok !== 1) return 0;
    return candelaSetParam(graph, 0, weight);
}

// Prepare geometry (phase 0), extract the real winning material and sphere mask
// (phase 1), or evaluate shadows only on visible plane pixels (phase 2).
function typedMatRowPhase(work: buffer, graph: buffer, ids: buffer, visible: buffer,
                          shadows: buffer, y: i32, phase: i32): i32 {
    if (work.length < 2048 || !candelaHeader(graph) || y < 0 || y >= 160 ||
        ids.length < 160 || visible.length < 160 || shadows.length < 160) return 0;
    if (phase === 0) {
        const count = graph.charCodeAt(4);
        work.setCharCodeAt(16, count);
        for (let i = 0; i < 5 * count; i = i + 1) {
            work.setCharCodeAt(1 + i, graph.charCodeAt(280 + i));
        }
        return typedRayBuildTables(work, 31, 25);
    }
    if (phase === 1) {
        typedRayComputeRow(work, y);
        for (let x = 0; x < 160; x = x + 1) {
            const id = work.charCodeAt(1705 + x);
            let mat = graph.charCodeAt(6);
            if (id !== 0) { mat = work.charCodeAt(5 + 5 * (id - 1)); }
            ids.setCharCodeAt(x, mat);
            visible.setCharCodeAt(x, id);
        }
        return 1;
    }
    if (phase === 2) {
        for (let x = 0; x < 160; x = x + 1) {
            let shadow = 0;
            if (visible.charCodeAt(x) === 0 && typedRayInShadow(work, x, y)) { shadow = 1; }
            shadows.setCharCodeAt(x, shadow);
        }
        return 1;
    }
    return 0;
}
