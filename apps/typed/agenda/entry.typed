// Task-entry grammar. Compiled together with reminder.typed, which supplies
// decimal() and validDate(). The reactor supplies the current local date.
function entryLower(code: i32): i32 {
    if (code >= 65 && code <= 90) return code + 32;
    return code;
}

// Minutes since midnight, -1 for a non-time word, -2 for a time-shaped error.
function entryClock(word: string, start: i32, end: i32): i32 {
    let limit = end;
    let suffix = 0;
    if (limit - start >= 3 && entryLower(word.charCodeAt(limit - 1)) === 109) {
        suffix = entryLower(word.charCodeAt(limit - 2));
        if (!(suffix === 97 || suffix === 112)) return -1;
        limit = limit - 2;
    }
    let width = limit - start;
    let minute = 0;
    if (width >= 4 && word.charCodeAt(limit - 3) === 58) {
        width = width - 3;
        minute = decimal(word, limit - 2, 2);
    }
    if (width < 1 || width > 2 || minute < 0) return -1;
    let hour = decimal(word, start, width);
    if (hour < 0) return -1;
    if (hour > 23 || minute > 59) return -2;
    if (suffix > 0) {
        if (hour < 1 || hour > 12) return -2;
        hour = hour % 12;
        if (suffix === 112) { hour = hour + 12; }
    }
    return hour * 60 + minute;
}

function entryTime(word: string): i32 {
    return Math.max(-1, entryClock(word, 0, word.length));
}

function entryMonthLength(year: i32, month: i32): i32 {
    if (month === 2 && leap(year)) return 29;
    if (month === 2) return 28;
    if (month === 4 || month === 6 || month === 9 || month === 11) return 30;
    return 31;
}

function entryAddDays(today: i32, count: i32): i32 {
    let year = today / 10000;
    let month = today / 100 % 100;
    let day = today % 100 + count;
    if (year < 100) { year = year + 1900; }
    let length = entryMonthLength(year, month);
    while (day > length) {
        day = day - length;
        month = month + 1;
        if (month > 12) { month = 1; year = year + 1; }
        length = entryMonthLength(year, month);
    }
    return year * 10000 + month * 100 + day;
}

// Sunday is zero. The old Date.UTC helper maps years 0–99 into 1900–1999.
function entryWeekday(today: i32): i32 {
    let year = today / 10000;
    if (year < 100) { year = year + 1900; }
    const prior = year - 1;
    let days = 365 * prior + prior / 4 - prior / 100 + prior / 400 + today % 100;
    let month = 1;
    while (month < today / 100 % 100) {
        days = days + entryMonthLength(year, month);
        month = month + 1;
    }
    return days % 7;
}

// Every four-digit date sorts before undated and completed tasks.
function agendaDateKey(date: i32, done: bool): i32 {
    if (done) return 100000001;
    if (date < 0) return 100000000;
    return date;
}

function agendaMark(done: bool, toggle: bool): i32 {
    if (done === toggle) return 32;
    return 120;
}

// Pack at most six letters into an i32, using a=1 through z=26 in base 32.
// Positive digits make the spelling and length unambiguous. Longer names
// split after six letters so neither chunk can overflow.
function entryLetters(word: string, start: i32, end: i32): i32 {
    let packed = 0;
    let at = start;
    while (at < end) {
        const letter = entryLower(word.charCodeAt(at)) - 96;
        if (letter < 1 || letter > 26) return -1;
        packed = packed * 32 + letter;
        at = at + 1;
    }
    return packed;
}

function entryRelative(word: string, start: i32, end: i32, today: i32): i32 {
    const first = entryLetters(word, start, Math.min(end, start + 6));
    const rest = entryLetters(word, start + 6, end);
    if (first === 21467193 || first === 20964) return today; // today, tod
    if (first === 20973 || first === 20914 ||
        (first === 687259218 && rest === 503)) return entryAddDays(today, 1); // tom, tmr, tomorrow
    let weekday = -1;
    if (first === 20142 || (first === 660017209 && rest === 0)) { weekday = 0; } // sun, sunday
    if (first === 13806 || (first === 452399161 && rest === 0)) { weekday = 1; } // mon, monday
    if (first === 21157 || (first === 693292161 && rest === 25)) { weekday = 2; } // tue, tuesday
    if (first === 23716 || (first === 777140403 && rest === 4153)) { weekday = 3; } // wed, wednesday
    if (first === 20757 || (first === 680184420 && rest === 57)) { weekday = 4; } // thu, thursday
    if (first === 6729 || (first === 220500025 && rest === 0)) { weekday = 5; } // fri, friday
    if (first === 19508 || (first === 639260228 && rest === 57)) { weekday = 6; } // sat, saturday
    if (weekday >= 0) return entryAddDays(today, (weekday - entryWeekday(today) + 6) % 7 + 1);
    if (end - start < 3 || end - start > 5 || !(word.charCodeAt(start) === 43)) return -1;
    const count = decimal(word, start + 1, end - start - 2);
    if (count < 0) return -1;
    const unit = entryLower(word.charCodeAt(end - 1));
    if (unit === 100) return entryAddDays(today, count);
    if (unit === 119) return entryAddDays(today, count * 7);
    return -1;
}

function entryCalendar(word: string, start: i32, end: i32, today: i32, separator: i32): i32 {
    let at = separator;
    let year = today / 10000;
    let monthStart = start;
    if (separator - start === 4) {
        year = decimal(word, start, 4);
        monthStart = separator + 1;
        at = monthStart;
        while (at < end && !(word.charCodeAt(at) === 45)) { at = at + 1; }
    }
    const width = at - monthStart;
    const dayWidth = end - at - 1;
    if (year < 0 || width < 1 || width > 2 || dayWidth < 1 || dayWidth > 2) return -1;
    const month = decimal(word, monthStart, width);
    const day = decimal(word, at + 1, dayWidth);
    if (monthStart === start && month * 100 + day < today % 10000) { year = year + 1; }
    if (!validDate(year, month, day)) return -1;
    return year * 10000 + month * 100 + day;
}

function entryDateAt(word: string, start: i32, end: i32, today: i32): i32 {
    if (end - start < 1 || end - start > 10) return -1;
    let at = start;
    while (at < end && !(word.charCodeAt(at) === 45)) { at = at + 1; }
    if (at - start === 4 && at < end) return entryCalendar(word, start, end, today, at);
    if (today < 0) return -1;
    if (at > start && at - start <= 2 && at < end) return entryCalendar(word, start, end, today, at);
    return entryRelative(word, start, end, today);
}

// Input omits '@'. Today and the result use YYYYMMDD; -1 is invalid/unset.
function entryDate(word: string, today: i32): i32 {
    return entryDateAt(word, 0, word.length, today);
}

function entryWordEnd(input: string, start: i32): i32 {
    let at = start;
    while (at < input.length && !space(input.charCodeAt(at))) { at = at + 1; }
    return at;
}

function entryYmdShape(input: string, start: i32, end: i32): bool {
    if (end - start < 8 || end - start > 10 || decimal(input, start, 4) < 0 ||
        !(input.charCodeAt(start + 4) === 45)) return false;
    let split = start + 6;
    if (!(input.charCodeAt(split) === 45)) { split = split + 1; }
    if (!(input.charCodeAt(split) === 45) || end - split < 2 || end - split > 3) return false;
    return decimal(input, start + 5, split - start - 5) >= 0 &&
        decimal(input, split + 1, end - split - 1) >= 0;
}

function entryPut(output: buffer, at: i32, code: i32): i32 {
    if (at < 0 || at >= output.length) return -7;
    output.setCharCodeAt(at, code);
    return at + 1;
}

function entryNumber(output: buffer, at: i32, value: i32, divider: i32): i32 {
    let pos = at;
    let scale = divider;
    while (value / scale >= 10) { scale = scale * 10; }
    while (scale > 0) {
        pos = entryPut(output, pos, 48 + value / scale % 10);
        scale = scale / 10;
    }
    return pos;
}

function entryCopy(input: string, start: i32, end: i32, output: buffer, at: i32): i32 {
    let from = start;
    let pos = at;
    while (from < end && pos >= 0) {
        pos = entryPut(output, pos, input.charCodeAt(from));
        from = from + 1;
    }
    return pos;
}

function entryWriteDate(output: buffer, at: i32, date: i32): i32 {
    let pos = entryPut(output, at, 64);
    pos = entryNumber(output, pos, date / 10000, 1);
    pos = entryPut(output, pos, 45);
    pos = entryNumber(output, pos, date / 100 % 100, 10);
    pos = entryPut(output, pos, 45);
    return entryNumber(output, pos, date % 100, 10);
}

function entryFailure(error: WorldState, start: i32, end: i32, code: i32): i32 {
    error.errorStart = start;
    error.errorEnd = end;
    return code;
}

// On success return the canonical prompt length in code units. On failure:
// -1 duplicate date, -2 clock unset, -3 bad date, -4 bad time,
// -5 bad lead, -6 no title, -7 output capacity. Errors -3 and -4 write the
// offending token's half-open UTF-16 span. Ignore output on failure.
function normalizeEntry(input: string, today: i32, output: buffer, error: WorldState): i32 {
    let at = skipSpace(input, 0);
    let written = 0;
    let hasDate = false;
    let hasLead = false;
    let hasTitle = false;
    while (at < input.length) {
        let end = entryWordEnd(input, at);
        const code = input.charCodeAt(at);
        const dateWord = code === 64 && end - at > 1;
        if (written > 0) { written = entryPut(output, written, 32); }
        if (dateWord) {
            if (hasDate) return -1;
            if (today < 0 && !entryYmdShape(input, at + 1, end)) return -2;
            const date = entryDateAt(input, at + 1, end, today);
            if (date < 0) return entryFailure(error, at, end, -3);
            hasDate = true;
            // The original title check only strips dates with four-digit years.
            if (date / 10000 < 1000 || date / 10000 > 9999) { hasTitle = true; }
            written = entryWriteDate(output, written, date);
            const next = skipSpace(input, end);
            const nextEnd = entryWordEnd(input, next);
            const time = entryClock(input, next, nextEnd);
            if (time === -2) return entryFailure(error, next, nextEnd, -4);
            if (time >= 0) {
                written = entryPut(output, written, 32);
                written = entryNumber(output, written, time / 60, 10);
                written = entryPut(output, written, 58);
                written = entryNumber(output, written, time % 60, 10);
                end = nextEnd;
            }
        }
        if (!dateWord) {
            const leadWord = code === 33 && end - at > 1;
            if (leadWord && leadValue(input, at, end) < 0) return -5;
            if (!leadWord || hasLead) { hasTitle = true; }
            if (leadWord) { hasLead = true; }
            written = entryCopy(input, at, end, output, written);
        }
        if (written < 0) return written;
        at = skipSpace(input, end);
    }
    if (!hasTitle) return -6;
    return written;
}
