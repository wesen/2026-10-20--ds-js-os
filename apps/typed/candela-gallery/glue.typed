// cdlSky(k): the 64 x 64 sky table from the scene's sun and sky rows (cdl_overrides.inc cdl_sky_bind).
function cdlSky(q_k: K): i32 {
    return skyBuild(q_k);
}
// cdlRenderSpan(k, out, y, x0, x1, frame): one camera sample per pixel x0..x1-1 of row y, 12 floats each (cdl_pixout).
function cdlRenderSpan(q_k: K, out: buffer, y: i32, x0: i32, x1: i32, frame: i32): i32 {
    const o = q_k.pix;
    let at: i32 = 0;
    for (let x: i32 = x0; x < x1; x = x + 1) {
        renderPixel(q_k, o, f32(x), f32(y), frame);
        out.setF32(at + 0, o.c__x);
        out.setF32(at + 1, o.c__y);
        out.setF32(at + 2, o.c__z);
        out.setF32(at + 3, o.c__w);
        out.setF32(at + 4, o.alb__x);
        out.setF32(at + 5, o.alb__y);
        out.setF32(at + 6, o.alb__z);
        out.setF32(at + 7, o.alb__w);
        out.setF32(at + 8, o.nrm__x);
        out.setF32(at + 9, o.nrm__y);
        out.setF32(at + 10, o.nrm__z);
        out.setF32(at + 11, o.nrm__w);
        at = at + 12;
    }
    return 1;
}
