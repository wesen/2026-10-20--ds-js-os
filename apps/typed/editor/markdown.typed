function editorWhitespace(unit: i32): bool {
    return (unit >= 9 && unit <= 13) || unit === 32 || unit === 160 || unit === 5760 ||
        (unit >= 8192 && unit <= 8202) || unit === 8232 || unit === 8233 || unit === 8239 ||
        unit === 8287 || unit === 12288 || unit === 65279;
}

function editorMdSpace(text: string, from: i32, end: i32): i32 {
    let at = from;
    while (at < end && editorWhitespace(text.charCodeAt(at))) { at = at + 1; }
    return at;
}

function editorMdSuffix(text: string, literal: buffer, size: i32): bool {
    if (text.length < size) return false;
    const start = text.length - size;
    let i = 0;
    while (i < size && text.charCodeAt(start + i) < 128 &&
        editorFold(text.charCodeAt(start + i)) === literal.charCodeAt(i)) { i = i + 1; }
    return i === size;
}

function editorIsMarkdown(state: WorldState): bool {
    const name = typedSdkView(typedSdkBuffer(1), state.nameLength);
    const scratch = typedSdkBuffer(7);
    if (editorMdSuffix(name, scratch, scratch.writeLiteral(0, ".md"))) return true;
    return editorMdSuffix(name, scratch, scratch.writeLiteral(0, ".markdown"));
}

function editorMdFence(text: string, first: i32, end: i32): bool {
    const at = editorMdSpace(text, first, end);
    return at + 3 <= end && text.charCodeAt(at) === 96 && text.charCodeAt(at + 1) === 96 && text.charCodeAt(at + 2) === 96;
}

function editorMdHeading(text: string, first: i32, end: i32): i32 {
    let at = first;
    while (at < end && at - first <= 6 && text.charCodeAt(at) === 35) { at = at + 1; }
    if (at === first || at - first > 6 || at >= end || !editorWhitespace(text.charCodeAt(at))) return 0;
    return at - first;
}

function editorMdColor(text: string, first: i32, end: i32, fenced: bool): i32 {
    if (fenced || editorMdFence(text, first, end)) return 1;
    if (editorMdHeading(text, first, end) > 0) return 2;
    const at = editorMdSpace(text, first, end);
    if (at < end && text.charCodeAt(at) === 62) return 3;
    return 0;
}

// Return the marker's exclusive end, before the whitespace it requires.
function editorMdMarker(text: string, start: i32, end: i32): i32 {
    if (start >= end) return 0;
    const first = text.charCodeAt(start);
    if (first === 45 || first === 42 || first === 43) return start + 1;
    let at = start;
    while (at < end && text.charCodeAt(at) >= 48 && text.charCodeAt(at) <= 57) { at = at + 1; }
    if (at === start || at >= end) return 0;
    const punctuation = text.charCodeAt(at);
    if (punctuation === 46 || punctuation === 41) return at + 1;
    return 0;
}

function editorMdListEnd(text: string, start: i32, end: i32): i32 {
    const at = editorMdMarker(text, start, end);
    if (at <= start || at >= end || !editorWhitespace(text.charCodeAt(at))) return 0;
    return at;
}

function editorMdNextMarker(text: string, start: i32, end: i32, output: buffer): i32 {
    let first = start;
    while (first + 2 < end && text.charCodeAt(first) === 48) { first = first + 1; }
    let carry = end - 2;
    while (carry >= first && text.charCodeAt(carry) === 57) { carry = carry - 1; }
    let at = 0;
    if (carry < first) {
        output.setCharCodeAt(0, 49);
        at = 1;
    }
    let i = first;
    while (i < end - 1) {
        let unit = text.charCodeAt(i);
        if (i === carry) { unit = unit + 1; }
        if (i > carry) { unit = 48; }
        output.setCharCodeAt(at, unit);
        at = at + 1;
        i = i + 1;
    }
    output.setCharCodeAt(at, text.charCodeAt(end - 1));
    output.setCharCodeAt(at + 1, 32);
    return at + 2;
}

// Passes compact their input in place. A negative probe means that the
// next step searches for an opener. The closer search retains its cursor.
function editorMdEmit(state: WorldState, out: buffer, first: i32, end: i32, next: i32): i32 {
    if (!(state.mdWrite === first)) { typedSdkMove(out, state.mdWrite, first, end - first); }
    state.mdWrite = state.mdWrite + end - first;
    state.mdRead = next;
    state.mdProbe = -1;
    state.mdClose = -1;
    return 0;
}

function editorMdOpen(state: WorldState, out: buffer, text: string): i32 {
    let unit = 42;
    if (state.mdPass === 2) { unit = 96; }
    if (state.mdPass === 3) { unit = 91; }
    const limit = Math.min(state.mdSize, state.mdRead + 1024);
    const start = typedSdkSeek(text, state.mdRead, limit, unit, unit, unit, unit);
    editorMdEmit(state, out, state.mdRead, start, start);
    if (start === limit) return 0;
    if (!(state.mdPass === 1)) { state.mdProbe = start + 1; }
    if (!(state.mdPass === 1)) return 0;
    if (start + 2 >= state.mdSize || !(text.charCodeAt(start + 1) === 42) ||
        text.charCodeAt(start + 2) === 8232 || text.charCodeAt(start + 2) === 8233)
        return editorMdEmit(state, out, start, start + 1, start + 1);
    state.mdProbe = start + 3;
    return 0;
}

function editorMdBold(state: WorldState, out: buffer, text: string, limit: i32): i32 {
    const start = state.mdRead;
    const close = typedSdkSeek(text, state.mdProbe, limit, 42, 8232, 8233, 42);
    if (close === state.mdSize) return editorMdEmit(state, out, start, close, close);
    if (close < limit && !(text.charCodeAt(close) === 42))
        return editorMdEmit(state, out, start, close + 1, close + 1);
    if (close < limit && close + 1 < state.mdSize && text.charCodeAt(close + 1) === 42)
        return editorMdEmit(state, out, start + 2, close, close + 2);
    state.mdProbe = Math.min(limit, close + 1);
    return 0;
}

function editorMdCode(state: WorldState, out: buffer, text: string, limit: i32): i32 {
    const start = state.mdRead;
    const close = typedSdkSeek(text, state.mdProbe, limit, 96, 96, 96, 96);
    if (close === state.mdSize) return editorMdEmit(state, out, start, close, close);
    if (close < limit && close === start + 1)
        return editorMdEmit(state, out, start, close, close);
    if (close < limit) return editorMdEmit(state, out, start + 1, close, close + 1);
    state.mdProbe = limit;
    return 0;
}

function editorMdLink(state: WorldState, out: buffer, text: string, limit: i32): i32 {
    const start = state.mdRead;
    let unit = 93;
    if (state.mdClose >= 0) { unit = 41; }
    const stop = typedSdkSeek(text, state.mdProbe, limit, unit, unit, unit, unit);
    if (stop === state.mdSize) return editorMdEmit(state, out, start, stop, stop);
    if (stop === limit) { state.mdProbe = limit; }
    if (stop === limit) return 0;
    if (state.mdClose >= 0) return editorMdEmit(state, out, start + 1, state.mdClose, stop + 1);
    // Openers through this bracket share the same failed ending.
    if (stop === start + 1 || stop + 1 >= state.mdSize || !(text.charCodeAt(stop + 1) === 40))
        return editorMdEmit(state, out, start, stop + 1, stop + 1);
    state.mdClose = stop;
    state.mdProbe = stop + 2;
    return 0;
}

function editorMdMatch(state: WorldState, scratch: buffer, text: string): i32 {
    if (state.mdProbe < 0) return editorMdOpen(state, scratch, text);
    const limit = Math.min(state.mdSize, state.mdProbe + 1024);
    if (state.mdPass === 1) return editorMdBold(state, scratch, text, limit);
    if (state.mdPass === 2) return editorMdCode(state, scratch, text, limit);
    return editorMdLink(state, scratch, text, limit);
}

function editorMdStep(state: WorldState): i32 {
    const scratch = typedSdkBuffer(10);
    const text = typedSdkView(scratch, state.mdSize);
    if (state.mdRead < state.mdSize) { editorMdMatch(state, scratch, text); }
    if (state.mdRead < state.mdSize) return 0;
    state.mdSize = state.mdWrite;
    state.mdRead = state.mdStart;
    state.mdWrite = state.mdStart;
    state.mdPass = state.mdPass + 1;
    if (state.mdPass < 4) return 0;
    state.mdPass = 0;
    state.mdRead = 0;
    state.previewEnd = state.mdSize;
    if (state.previewKind === 1 || state.previewKind === 5) { state.previewEnd = 0; }
    return 0;
}
