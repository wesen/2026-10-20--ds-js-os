function editorFindMatch(text: string, at: i32, end: i32, query: buffer, size: i32): bool {
    if (end - at < size) return false;
    let i = 0;
    while (i < size && editorFold(text.charCodeAt(at + i)) === editorFold(query.charCodeAt(i)) &&
        (!(text.charCodeAt(at + i) === 304) || i + 1 === size)) { i = i + 1; }
    return i === size;
}

function editorSetFound(state: WorldState, text: string, end: i32, found: i32): i32 {
    let at = Math.min(end, found);
    if (at > 0 && at < end && editorLowSurrogate(text.charCodeAt(at)) &&
        editorHighSurrogate(text.charCodeAt(at - 1))) { at = at + 1; }
    state.cursor = at;
    state.goal = -1;
    state.notice = 0;
    return 0;
}

function editorFindActive(phase: FindPhase): bool {
    match (phase) {
        LineSuffix, LaterLines, EarlierLines, LinePrefix: { return true; }
        NotFound, Found: { return false; }
    }
    return false;
}

function editorFindAdvance(phase: FindPhase, hasFollowingLine: bool): FindPhase {
    match (phase) {
        LineSuffix, LaterLines: {
            if (hasFollowingLine) return FindPhase.LaterLines;
            return FindPhase.EarlierLines;
        }
        EarlierLines, NotFound, Found: { return phase; }
        LinePrefix: { return FindPhase.NotFound; }
    }
    return phase;
}

async function editorFindTask(state: WorldState, advance: bool): i32 {
    const initialText = typedSdkView(typedSdkBuffer(0), state.textLength);
    const newline = typedSdkLastIndex(initialText, 0, state.cursor, 10);
    let at = 0;
    if (newline < state.cursor) { at = newline + 1; }
    let end = editorLineEnd(initialText, at);
    let anchor = state.cursor;
    if (advance) { anchor = Math.min(end, editorNext(initialText, state.cursor)); }
    let foldedAt = at;
    let phase = FindPhase.LineSuffix;
    while (editorFindActive(phase)) {
        const text = typedSdkView(typedSdkBuffer(0), state.textLength);
        const query = typedSdkBuffer(6);
        const size = state.queryLength;
        const low = editorFold(query.charCodeAt(0));
        let upper = low;
        if (low >= 97 && low <= 122) { upper = low - 32; }
        let alternate = low;
        if (low === 107) { alternate = 8490; }
        let work = 0;
        while (work < 1024) {
            work = work + 1;
            let candidate = end;
            if (at < end) { candidate = typedSdkSeek(text, at, end, low, upper, alternate, 304); }
            const folded = foldedAt + candidate - at;
            let limit = end;
            if (phase === FindPhase.LinePrefix && folded >= anchor) { limit = candidate; }
            if (candidate >= limit) {
                let next = end + 1;
                const following = next < text.length;
                if (!following && (phase === FindPhase.LineSuffix || phase === FindPhase.LaterLines)) { next = 0; }
                phase = editorFindAdvance(phase, following);
                if (phase === FindPhase.NotFound) { break; }
                end = editorLineEnd(text, next);
                // On wrap, the line containing the anchor is the cursor line.
                if (phase === FindPhase.EarlierLines && end >= anchor) { phase = FindPhase.LinePrefix; }
                at = next;
                foldedAt = next;
            } else {
                const eligible = phase !== FindPhase.LineSuffix || folded >= anchor;
                at = candidate + 1;
                foldedAt = folded + 1;
                if (text.charCodeAt(candidate) === 304) { foldedAt = foldedAt + 1; }
                if (eligible) { work = work + size; }
                if (eligible && editorFindMatch(text, candidate, end, query, size)) {
                    editorSetFound(state, text, end, folded);
                    phase = FindPhase.Found;
                    break;
                }
            }
        }
        if (editorFindActive(phase)) {
            const paused = await typedSdkYield();
            if (!paused) {
                state.notice = 11;
                return 0;
            }
        }
    }
    if (phase === FindPhase.NotFound) { state.notice = 10; }
    return 0;
}

function editorFindNext(state: WorldState, advance: bool): i32 {
    cancel editorFindTask;
    if (state.queryLength <= 0 && advance) { state.notice = 9; }
    if (state.queryLength <= 0) return 0;
    start editorFindTask(state, advance);
    return 0;
}

function editorFindInput(state: WorldState, key: i32, ch: i32, held: bool): i32 {
    if (key === 15 && !held) {
        state.finding = false;
        state.queryLength = 0;
        state.notice = 0;
    }
    if (!state.finding) return 0;
    if (key === 11 && !held) {
        state.finding = false;
        state.notice = 0;
    }
    if (!state.finding) return editorFindNext(state, false);
    if (key === 9) {
        state.queryLength = Math.max(0, state.queryLength - 1);
    }
    if (key === 9 || ch < 32 || ch > 126 || state.queryLength >= 60) return 0;
    const query = typedSdkBuffer(6);
    query.setCharCodeAt(state.queryLength, ch);
    state.queryLength = state.queryLength + 1;
    return 0;
}

function editorBeginFind(state: WorldState): i32 {
    cancel editorFindTask;
    state.finding = true;
    return 0;
}

function editorFindStatus(buf: buffer, state: WorldState): i32 {
    let at = 0;
    if (state.finding) { at = buf.writeLiteral(0, "Find: "); }
    if (!state.finding) { at = buf.writeLiteral(0, "Not found: "); }
    const query = typedSdkBuffer(6);
    let i = 0;
    while (i < state.queryLength) {
        buf.setCharCodeAt(at, query.charCodeAt(i));
        at = at + 1;
        i = i + 1;
    }
    if (state.finding) { at = at + buf.writeLiteral(at, "_"); }
    return at;
}

function editorFindMark(out: buffer, offset: i32, row: i32, col: i32, size: i32): i32 {
    let at = offset + out.writeLiteral(offset, "[");
    at = editorDigits(out, at, row);
    out.setCharCodeAt(at, 44);
    at = editorDigits(out, at + 1, col);
    out.setCharCodeAt(at, 44);
    at = editorDigits(out, at + 1, size);
    return at + out.writeLiteral(at, ",\"soft\"]");
}

function editorFindMarks(out: buffer, offset: i32, text: string, state: WorldState): i32 {
    if (state.queryLength <= 0) return offset;
    let at = offset;
    const query = typedSdkBuffer(6);
    editorFrameRow(text, state, state.top);
    let row = 0;
    let more = true;
    while (row < 17 && more) {
        const start = state.rowStart;
        const end = state.rowEnd;
        let pos = start;
        let folded = 0;
        while (pos < end) {
            if (editorFindMatch(text, pos, end, query, state.queryLength)) {
                if (at > offset) { at = at + out.writeLiteral(at, ","); }
                at = editorFindMark(out, at, row, editorColumn(text, start, Math.min(end, start + folded)), state.queryLength);
            }
            if (text.charCodeAt(pos) === 304) { folded = folded + 1; }
            pos = pos + 1;
            folded = folded + 1;
        }
        more = editorNextRow(text, state);
        row = row + 1;
    }
    return at;
}
