// The PicoCalc compositor's 304px body leaves 296px after the lines inset.
// Small type is 6x12, so a row holds 49 code points and the body shows 17 rows.
// Each of the 36 ring entries holds two headers and up to 98 UTF-16 units.
// Kind values 0 through 5 describe a paragraph, accent heading, code,
// quote, list item, and ink heading. -1 waits for input and -2 marks EOF.
function editorPreviewSlot(row: i32): i32 {
    return (row % 36) * 100;
}

function editorPreviewFinish(rows: buffer, state: WorldState, kind: i32): i32 {
    const slot = editorPreviewSlot(state.previewRows);
    rows.setCharCodeAt(slot, state.previewUnits);
    rows.setCharCodeAt(slot + 1, kind);
    state.previewRows = state.previewRows + 1;
    state.previewUnits = 0;
    state.previewColumns = 0;
    return 0;
}

function editorPreviewAppend(rows: buffer, state: WorldState, text: string, start: i32, end: i32, cols: i32): i32 {
    const slot = editorPreviewSlot(state.previewRows) + 2;
    let at = slot + state.previewUnits;
    if (state.previewUnits > 0) {
        rows.setCharCodeAt(at, 32);
        at = at + 1;
        state.previewColumns = state.previewColumns + 1;
    }
    let i = start;
    while (i < end) {
        rows.setCharCodeAt(at, text.charCodeAt(i));
        at = at + 1;
        i = i + 1;
    }
    state.previewUnits = at - slot;
    state.previewColumns = state.previewColumns + cols;
    return 0;
}

function editorPreviewIndent(kind: i32): i32 {
    if (kind >= 2 && kind <= 4) return 2;
    return 0;
}

// Feed one word or one width-limited piece of a long word into the pending
// display row. A literal space separates words, as in compositor.wrapText.
function editorPreviewWord(rows: buffer, text: string, state: WorldState): i32 {
    const kind = state.previewKind;
    const width = 49 - editorPreviewIndent(kind);
    const first = state.previewAt;
    let end = first;
    let cols = 0;
    while (end < state.previewEnd && cols < width && !(text.charCodeAt(end) === 32)) {
        end = editorNext(text, end);
        cols = cols + 1;
    }
    const split = end < state.previewEnd && !(text.charCodeAt(end) === 32);
    if (state.previewUnits > 0 && (split || state.previewColumns + 1 + cols > width))
        return editorPreviewFinish(rows, state, kind);
    editorPreviewAppend(rows, state, text, first, end, cols);
    state.previewAt = end + 1;
    if (split) { state.previewAt = end; }
    if (split) return editorPreviewFinish(rows, state, kind);
    return 0;
}

function editorPreviewStage(text: string, first: i32, end: i32, list: i32, state: WorldState): i32 {
    const out = typedSdkBuffer(10);
    let at = 0;
    if (state.previewKind === 4) {
        const start = editorMdSpace(text, state.previewOffset, list);
        if (list - start === 1) { at = out.writeLiteral(0, "•"); }
        if (list - start > 1) { at = typedSdkCopySpan(text, start, list, out, 0); }
        out.setCharCodeAt(at, 32);
        at = at + 1;
    }
    state.mdStart = at;
    state.mdSize = typedSdkCopySpan(text, first, end, out, at);
    state.mdRead = at;
    state.mdWrite = at;
    state.mdProbe = -1;
    state.mdClose = -1;
    state.mdPass = 1;
    state.previewAt = 0;
    state.previewEnd = 0;
    return 0;
}

// Retain the unconsumed expansion and keep enough lookahead for 50 code
// points. This lets the word wrapper distinguish a full row from a long word
// even when the conversion boundary falls inside a word or an expansion.
function editorPreviewUpper(state: WorldState): i32 {
    const remaining = state.previewEnd - state.previewAt;
    if (remaining >= 100 || state.mdRead >= state.mdSize) return 0;
    const text = typedSdkView(typedSdkBuffer(10), state.mdSize);
    const out = typedSdkBuffer(7);
    if (remaining > 0) { typedSdkMove(out, 0, state.previewAt, remaining); }
    let at = Math.max(0, remaining);
    while (at < 100 && state.mdRead < state.mdSize) {
        let end = Math.min(state.mdSize, state.mdRead + 32);
        if (end < state.mdSize && editorHighSurrogate(text.charCodeAt(end - 1))) { end = end - 1; }
        at = typedSdkUpper(text, state.mdRead, end, out, at);
        state.mdRead = end;
    }
    state.previewAt = 0;
    state.previewEnd = at;
    return 0;
}

function editorPreviewCooked(rows: buffer, text: string, state: WorldState): i32 {
    const kind = state.previewKind;
    if (kind === 1 || kind === 5) { editorPreviewUpper(state); }
    if (state.previewAt > state.previewEnd) {
        if (!(kind === 0)) { editorPreviewFinish(rows, state, kind); }
        state.previewKind = -1;
    }
    if (state.previewAt > state.previewEnd) return 0;
    if (state.previewFromDocument) return editorPreviewWord(rows, text, state);
    let slot = 10;
    if (kind === 1 || kind === 5) { slot = 7; }
    return editorPreviewWord(rows, typedSdkView(typedSdkBuffer(slot), state.previewEnd), state);
}

function editorPreviewSource(rows: buffer, text: string, state: WorldState): i32 {
    const start = state.previewOffset;
    if (start > text.length) {
        if (state.previewParagraph) { editorPreviewFinish(rows, state, 0); }
        state.previewParagraph = false;
        state.previewKind = -2;
    }
    if (start > text.length) return 0;
    const end = editorLineEnd(text, start);
    let first = editorMdSpace(text, start, end);
    const fence = editorMdFence(text, first, end);
    let kind = 0;
    let stop = end;
    let list = 0;
    const heading = editorMdHeading(text, start, end);
    if (fence) { kind = -3; }
    if (!fence && state.previewFence) { kind = 2; }
    if (!fence && !state.previewFence) {
        if (first === end) { kind = -4; }
        if (heading > 0) {
            kind = 1;
            if (heading > 2) { kind = 5; }
            first = editorMdSpace(text, first + heading, end);
        }
        if (kind === 0) {
            list = editorMdListEnd(text, first, end);
            if (list > 0) {
                kind = 4;
                first = editorMdSpace(text, list, end);
            }
        }
        if (kind === 0 && text.charCodeAt(first) === 62) {
            kind = 3;
            first = first + 1;
            if (first < end && editorWhitespace(text.charCodeAt(first))) { first = first + 1; }
        }
        if (kind === 0) {
            while (stop > first && editorWhitespace(text.charCodeAt(stop - 1))) { stop = stop - 1; }
        }
    }
    const flush = !(kind === 0) && state.previewParagraph;
    if (flush) { state.previewParagraph = false; }
    if (flush) return editorPreviewFinish(rows, state, 0);
    state.previewKind = kind;
    state.previewFromDocument = kind === 2;
    if (kind === 0 || kind === 3) {
        state.previewFromDocument = typedSdkSeek(text, first, stop, 42, 96, 91, 42) === stop;
    }
    const stage = kind >= 0 && !state.previewFromDocument;
    if (stage) { editorPreviewStage(text, first, stop, list, state); }
    state.previewOffset = end + 1;
    if (kind === -3) { state.previewFence = !state.previewFence; }
    if (kind < 0) { state.previewKind = -1; }
    if (kind === -4 || kind === 1 || kind === 5) { editorPreviewFinish(rows, state, 0); }
    if (kind === 0) { state.previewParagraph = true; }
    if (kind === 2) { first = start; }
    if (state.previewFromDocument) {
        state.previewAt = first;
        state.previewEnd = stop;
    }
    if (stage) return (stop - first) / 1024;
    return 0;
}

function editorPreviewReset(state: WorldState): i32 {
    state.previewRows = 0;
    state.previewUnits = 0;
    state.previewColumns = 0;
    state.previewOffset = 0;
    state.previewKind = -1;
    state.previewParagraph = false;
    state.previewFence = false;
    state.previewToken = 0;
    state.mdPass = 0;
    return 0;
}

function editorPreviewReady(text: string, state: WorldState): bool {
    if (state.previewToken > 0) return false;
    // The pending row (if any) shares the ring and may have overwritten
    // the oldest entry. Backward navigation past that point rescans.
    if (state.previewTop < state.previewRows - 35) { editorPreviewReset(state); }
    const rows = typedSdkBuffer(8);
    let steps = 0;
    while (!(state.previewKind === -2) && state.previewRows < state.previewTop + 17 && steps < 96) {
        const kind = state.previewKind;
        if (kind === -1) { steps = steps + editorPreviewSource(rows, text, state); }
        if (state.mdPass > 0) {
            editorMdStep(state);
            steps = steps + 8;
        }
        if (kind >= 0 && state.mdPass === 0) { editorPreviewCooked(rows, text, state); }
        steps = steps + 1;
    }
    if (state.previewKind === -2 || state.previewRows >= state.previewTop + 17) return true;
    state.previewToken = typedSdkYield();
    return false;
}

function editorPreviewFrame(out: buffer, prefix: i32, state: WorldState): i32 {
    const rows = typedSdkView(typedSdkBuffer(8), 3600);
    let at = prefix + out.writeLiteral(prefix, ",{\"t\":\"lines\",\"wrapped\":true,\"items\":[");
    const first = Math.min(state.previewTop, Math.max(0, state.previewRows - 17));
    let row = first;
    while (row < Math.min(state.previewRows, first + 17)) {
        if (row > first) { at = at + out.writeLiteral(at, ","); }
        const slot = editorPreviewSlot(row);
        const kind = rows.charCodeAt(slot + 1);
        at = at + out.writeLiteral(at, "{\"s\":");
        at = editorQuote(out, at, rows, slot + 2, slot + 2 + rows.charCodeAt(slot));
        if (kind === 1) { at = at + out.writeLiteral(at, ",\"color\":\"accent\""); }
        if (kind === 2) { at = at + out.writeLiteral(at, ",\"color\":\"blue\""); }
        if (kind === 3) { at = at + out.writeLiteral(at, ",\"color\":\"muted\""); }
        if (kind === 5) { at = at + out.writeLiteral(at, ",\"color\":\"ink\""); }
        if (editorPreviewIndent(kind) > 0) { at = at + out.writeLiteral(at, ",\"indent\":2"); }
        at = at + out.writeLiteral(at, "}");
        row = row + 1;
    }
    return at + out.writeLiteral(at, "],\"font\":\"s\",\"lead\":2,\"grow\":1}]}");
}

function editorBeginPreview(state: WorldState): i32 {
    state.preview = true;
    state.previewTop = 0;
    return editorPreviewReset(state);
}

function editorPreviewKey(state: WorldState, action: i32, held: bool): i32 {
    if ((action === 15 || action === 18) && !held) {
        state.preview = false;
        state.previewToken = 0;
    }
    if (action === 3) { state.previewTop = Math.max(0, state.previewTop - 1); }
    if (action === 4) { state.previewTop = state.previewTop + 1; }
    if (action === 5) { state.previewTop = Math.max(0, state.previewTop - 16); }
    if (action === 6) { state.previewTop = state.previewTop + 16; }
    return 0;
}
